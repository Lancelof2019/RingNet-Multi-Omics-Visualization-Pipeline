<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Multi-omics Visualization - G6</title>

  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@antv/g6@5/dist/g6.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      font-family: sans-serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #fff;
    }

    #controls {
      padding: 10px;
      background: #f7f7f7;
      border-bottom: 1px solid #ddd;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      min-height: 245px;
      z-index: 100;
      overflow-y: auto;
    }

    #controls label,
    #controls div {
      margin-right: 18px;
      display: inline-block;
      vertical-align: middle;
    }

    #controls input[type="color"] {
      width: 24px;
      height: 24px;
      padding: 0;
      border: none;
      margin-left: 4px;
      vertical-align: middle;
    }

    #networkContainer {
      position: absolute;
      top: 245px;
      left: 0;
      right: 0;
      bottom: 0;
      overflow: hidden;
      background: white;
    }

    #networkViz {
      width: 100%;
      height: 100%;
      background: white;
      position: relative;
    }

    #selfLoopOverlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
      z-index: 20;
    }

    #zoomControls {
      position: fixed;
      top: 265px;
      right: 20px;
      z-index: 200;
    }

    #zoomControls button {
      display: block;
      margin-bottom: 5px;
      font-size: 18px;
      width: 40px;
      height: 40px;
    }

    .hint {
      color: #666;
      font-size: 12px;
      margin-left: 10px;
    }


    #paletteSelector {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
      margin-bottom: 2px;
      padding: 0;
      border: none;
      background: transparent;
      font-size: inherit;
    }

    #paletteSelector .palette-title {
      font-weight: 400;
      margin-right: 0;
      font-size: inherit;
    }

    #paletteSelector label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin: 0;
      cursor: pointer;
      user-select: none;
      font-size: inherit;
    }

    #paletteSelector input[type="checkbox"] {
      width: 15px;
      height: 15px;
      margin: 0;
    }

    .display-mode-disabled {
      opacity: 0.42;
      filter: grayscale(100%);
    }

    .display-mode-disabled label,
    .display-mode-disabled input {
      cursor: not-allowed !important;
    }


    #geneSearchRow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    #geneSearchInput {
      width: 180px;
      height: 28px;
      padding: 4px 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 13px;
    }

    #geneSearchStatus {
      color: #666;
      font-size: 12px;
      margin-left: 4px;
      max-width: 520px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      vertical-align: middle;
    }

    .pattern-discovery-disabled {
      opacity: 0.42;
      filter: grayscale(100%);
    }

    .pattern-discovery-disabled label,
    .pattern-discovery-disabled input,
    .pattern-discovery-disabled select {
      cursor: not-allowed !important;
    }

    .pattern-discovery-active-label {
      font-weight: 700;
      color: #0f172a;
    }
  </style>
</head>

<body>
  <div id="controls">
    <label>
      Network:
      <select id="commSelect"></select>
    </label>

    <label>
      Layout:
      <select id="layoutSelect">
        <option value="loose-balanced" selected>Loose Balanced</option>
        <option value="soft-spread">Soft Spread</option>
        <option value="spread-force">Spread Force</option>
        <option value="component-grid">Component Grid</option>
        <option value="concentric">Concentric</option>
        <option value="grid">Grid</option>
        <option value="circle">Circle</option>
      </select>
    </label>

    <label>
      Degree Range:
      <input type="number" id="degMin" value="0" min="0" max="500" style="width:60px;">
      –
      <input type="number" id="degMax" value="500" min="0" max="500" style="width:60px;">
    </label>

    <button id="fitBtn">Fit</button>
    <button id="savePNGBtn">Save PNG</button>
    <button id="saveSVGBtn">Save SVG</button>
    <button id="saveJSONBtn">Save JSON</button>
    <button id="downloadSnapshotBtn" title="Download a ZIP containing graph data and the current viewer configuration">Save snapshot</button>

  <br>
    <div id="geneSearchRow">
      <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
        Node search:
        <input type="text" id="geneSearchInput" placeholder="Enter gene/node name" autocomplete="off">
      </label>
      <button id="geneSearchBtn" type="button">Search</button>
      <button id="geneClearBtn" type="button">Clear</button>
      <span id="geneSearchStatus"></span>
    </div>
<br>

    <div id="paletteSelector" aria-label="Color palette selection">
      <span class="palette-title">Color Palette:</span>
      <label title="Apply The New England Journal of Medicine color palette">
        <input type="checkbox" id="paletteOneToggle">
       NEJM
      </label>
      <label title="Apply Nature Cancer color palette">
        <input type="checkbox" id="paletteTwoToggle">
        Nature Cancer
      </label>
      <label title="Apply Lancet color palette">
        <input type="checkbox" id="paletteThreeToggle">
        Lancet
      </label>
      <label title="Apply Science color palette">
        <input type="checkbox" id="paletteFourToggle">
        Science
      </label>
    </div>

    <br>

    <div id="colorPickers" style="margin-top:8px;">
      <span>Data1:</span>
      <input type="color" id="expNeg" value="#0000FF" title="Data1 negative" />
      <input type="color" id="expZero" value="#F7F7F7" title="Data1 zero / neutral" />
      <input type="color" id="expPos" value="#FF0000" title="Data1 positive" />

      <span style="display:inline-block; width:30px;"></span>

      <span>Data2:</span>
      <input type="color" id="mtyNeg" value="#0000FF" title="Data2 negative" />
      <input type="color" id="mtyZero" value="#F7F7F7" title="Data2 zero / neutral" />
      <input type="color" id="mtyPos" value="#FF0000" title="Data2 positive" />

      <span style="display:inline-block; width:30px;"></span>

      <span>Data3:</span>
      <input type="color" id="cnvNeg" value="#0000FF" title="Data3 negative" />
      <input type="color" id="cnvZero" value="#F7F7F7" title="Data3 zero / neutral" />
      <input type="color" id="cnvPos" value="#FF0000" title="Data3 positive" />

      <span style="display:inline-block; width:30px;"></span>

      <span>Data4:</span>
      <input type="color" id="snvNeg" value="#0000FF" title="Data4 negative" />
      <input type="color" id="snvZero" value="#F7F7F7" title="Data4 zero / neutral" />
      <input type="color" id="snvPos" value="#FF0000" title="Data4 positive" />
    </div>

    <br>

    <div style="display:inline-block; margin-top:8px; vertical-align:middle;">
      <label>
        Data:
        <select id="omicsType">
          <option value="exp">Data1</option>
          <option value="mty">Data2</option>
          <option value="cnv">Data3</option>
          <option value="snv">Data4</option>
        </select>
      </label>

      <label>
        Data Norm:
        <select id="dataType">
          <option value="raw">Raw</option>
          <option value="norm">Min-Max norm</option>
          <option value="zscore">Z-score</option>
        </select>
      </label>

      <label>
        Value Range:
        <input type="number" id="rangeMin" value="0" step="0.1" style="width:60px;">
        -
        <input type="number" id="rangeMax" value="5" step="0.1" style="width:60px;">
      </label>

      <button id="filterBtn">Filter</button>

      <div id="patternDiscoveryRow" style="
        display:flex;
        width:100%;
        margin-top:8px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
      ">
        <label class="pattern-discovery-active-label" style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          <input type="checkbox" id="patternDiscoveryToggle">
          Pattern Discovery
        </label>

        <!--label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          Score intensity:
          <select disabled title="Pattern Discovery uses JSON exp_z/mty_z to calculate AntiScore, StageEvidence, TrendScore, and GroupScore.">
            <option selected>JSON Z-score</option>
          </select>
        </label-->

        <!--label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          Threshold data type:
          <select id="patternThresholdScale" disabled title="Pattern Discovery uses gene-wise JSON Z-score only. Hit selection and score intensity both use exp_z/mty_z.">
            <option value="zscore" selected>Gene-wise Z-score only</option>
          </select>
        </label-->

        <span id="patternDiscoveryModeStatus" class="hint"></span>
      </div>

      <div id="patternData1ThresholdRow" style="
        display:flex;
        width:100%;
        margin-top:6px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
      ">
        <span style="font-weight:700; min-width:58px;">Data1:</span>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          high ≥
          <input type="range" id="patternExpHighThresholdSlider" min="0" max="5" step="0.01" value="0.00" style="width:120px;">
          <input type="number" id="patternExpHighThresholdValue" value="0.00" min="0" max="5" step="0.01" style="width:70px;">
          <span id="patternExpHighThresholdRange" class="hint" style="margin-left:2px;"></span>
