    const x = (CX + PORT_RADIUS * Math.cos(angle)) / SPRITE_SIZE;
    const y = (CY + PORT_RADIUS * Math.sin(angle)) / SPRITE_SIZE;

    return { key: `p${i}`, angle, placement: [x, y] };
  });

  const NODE_PORTS = NODE_PORTS_META.map(({ key, placement }) => ({ key, placement }));

  function invalidateSprites() {
