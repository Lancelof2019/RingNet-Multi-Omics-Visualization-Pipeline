        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          low ≤
          <input type="range" id="patternExpLowThresholdSlider" min="-5" max="0" step="0.01" value="0.00" style="width:120px;">
          <input type="number" id="patternExpLowThresholdValue" value="0.00" min="-5" max="0" step="0.01" style="width:70px;">
          <span id="patternExpLowThresholdRange" class="hint" style="margin-left:2px;"></span>
        </label>
      </div>

      <div id="patternData2ThresholdRow" style="
        display:flex;
        width:100%;
        margin-top:6px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
      ">
        <span style="font-weight:700; min-width:58px;">Data2:</span>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          high ≥
          <input type="range" id="patternMtyHighThresholdSlider" min="0" max="5" step="0.01" value="0.00" style="width:120px;">
          <input type="number" id="patternMtyHighThresholdValue" value="0.00" min="0" max="5" step="0.01" style="width:70px;">
          <span id="patternMtyHighThresholdRange" class="hint" style="margin-left:2px;"></span>
        </label>

        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          low ≤
          <input type="range" id="patternMtyLowThresholdSlider" min="-5" max="0" step="0.01" value="0.00" style="width:120px;">
          <input type="number" id="patternMtyLowThresholdValue" value="0.00" min="-5" max="0" step="0.01" style="width:70px;">
          <span id="patternMtyLowThresholdRange" class="hint" style="margin-left:2px;"></span>
        </label>
      </div>

      <div id="patternStageAwareRow" style="
        display:flex;
        width:100%;
        margin-top:6px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
      ">
        <span style="font-weight:700;">Group-aware thresholds:</span>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          TrendScore:
          <input type="range" id="patternFinalTrendSlider" min="0" max="1" step="0.01" value="0.00" style="width:130px;">
          <input type="number" id="patternFinalTrendValue" value="0.00" min="0" max="1" step="0.01" style="width:70px;">
          <span id="patternFinalTrendRange" class="hint" style="margin-left:2px;"></span>
        </label>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          GroupScore:
          <input type="range" id="patternStageEvidenceSlider" min="0" max="1" step="0.01" value="0.00" style="width:130px;">
          <input type="number" id="patternStageEvidenceValue" value="0.00" min="0" max="1" step="0.01" style="width:70px;">
          <span id="patternStageEvidenceRange" class="hint" style="margin-left:2px;"></span>
        </label>
      </div>

      <div id="patternStageFreeRow" style="
        display:flex;
        width:100%;
        margin-top:6px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
      ">
        <span style="font-weight:700;">Group-free thresholds:</span>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
