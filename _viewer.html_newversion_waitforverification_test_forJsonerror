  function mapToPlainObjectOfPositions(mapObj) {
    const out = {};
    if (!(mapObj instanceof Map)) return out;
    mapObj.forEach((posMap, commId) => {
      const commKey = String(commId);
      out[commKey] = {};
      if (posMap instanceof Map) {
        posMap.forEach((p, nodeId) => {
          if (p && Number.isFinite(+p.x) && Number.isFinite(+p.y)) {
            out[commKey][String(nodeId)] = { x: +p.x, y: +p.y };
          }
        });
      }
    });
    return out;
  }

  function restoreNodePositionStore(positionObject) {
    nodePositionStoreByCommunity.clear();
    if (!positionObject || typeof positionObject !== 'object') return;

    Object.entries(positionObject).forEach(([commId, nodesObj]) => {
      const posMap = new Map();
      Object.entries(nodesObj || {}).forEach(([nodeId, p]) => {
        if (p && Number.isFinite(+p.x) && Number.isFinite(+p.y)) {
          posMap.set(String(nodeId), { x: +p.x, y: +p.y });
        }
      });
      if (posMap.size) nodePositionStoreByCommunity.set(String(commId), posMap);
    });
  }

