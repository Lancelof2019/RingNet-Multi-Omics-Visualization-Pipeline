  function angleDistance(a, b) {
    return Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));
  }

  function getNearestPortKeyByAngle(angle) {
    let bestKey = NODE_PORTS_META[0].key;
    let bestDist = Infinity;

    NODE_PORTS_META.forEach(p => {
      const d = angleDistance(angle, p.angle);
      if (d < bestDist) {
        bestDist = d;
        bestKey = p.key;
      }
    });

    return bestKey;
  }

  function getId(v) {
    if (Array.isArray(v)) return getId(v[0]);
    if (typeof v === 'object' && v !== null) {
      if ('id' in v && v.id != null) return getId(v.id);
      if ('gene' in v && v.gene != null) return String(v.gene);
      return '';
    }
    return String(v ?? '');
  }

  function endpointId(v) {
    if (Array.isArray(v)) return endpointId(v[0]);
    if (v && typeof v === 'object') {
      if (v.id != null) return String(v.id);
      if (v.gene != null) return String(v.gene);
      return '';
    }
    if (v == null) return '';
    return String(v);
  }


  // Added for Pattern Discovery edge debugging/fixing.
  // G6 may store edge endpoints either as strings or as node objects.
  // This helper creates a stable key even when edge.id is missing.
  function patternEdgeKey(edge) {
    if (!edge) return '';
    const id = edge.id;
    if (id !== undefined && id !== null && String(id) !== '' && String(id) !== 'undefined') {
      return String(id);
    }
    const s = endpointId(edge.source);
    const t = endpointId(edge.target);
    const type = firstNonEmptyString([
      edge.interact_id,
      edge.interact,
      edge.edge_name,
      edge.edge_type,
      edge.type,
      edge.relation,
      edge.label
    ]);
    const w = Number.isFinite(toNum(edge.w_raw)) ? toNum(edge.w_raw)
      : Number.isFinite(toNum(edge.weight)) ? toNum(edge.weight)
      : Number.isFinite(toNum(edge._w)) ? toNum(edge._w)
      : '';
    return `${s}__${t}__${type}__${w}`;
  }

  function toNum(v) {
    if (Array.isArray(v)) v = v[0];
    const n = +v;
    return Number.isFinite(n) ? n : NaN;
  }

  function meanAndSd(values) {
    const arr = values.map(toNum).filter(Number.isFinite);
    const mean = d3.mean(arr);
    let sd = d3.deviation(arr);
    if (!Number.isFinite(mean)) return { mean: NaN, sd: NaN };
    if (!Number.isFinite(sd) || sd === 0) sd = 1;
    return { mean, sd };
  }

  function safeMean(arr) {
    const nums = arr.map(toNum).filter(Number.isFinite);
    return nums.length ? d3.mean(nums) : NaN;
  }

  function safeSd(arr) {
    const nums = arr.map(toNum).filter(Number.isFinite);
    if (nums.length < 2) return 0;
    const sd = d3.deviation(nums);
    return Number.isFinite(sd) ? sd : 0;
  }

  function safeQuantile(arr, q) {
    const nums = arr.map(toNum).filter(Number.isFinite).sort(d3.ascending);
    if (!nums.length) return NaN;
    const v = d3.quantileSorted(nums, q);
    return Number.isFinite(v) ? v : NaN;
  }


  // Convert a distance into an intuitive similarity score.
  // distance smaller  => more similar
  // similarity larger => more similar
  // Range: (0, 1], where 1 means identical under this distance metric.
  function distanceToSimilarity(distance) {
    if (!Number.isFinite(distance)) return 0;
    return 1 / (1 + Math.max(0, distance));
  }

  function createOffscreen(size) {
    if (typeof OffscreenCanvas !== 'undefined') return new OffscreenCanvas(size, size);
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    return canvas;
  }

  function canvasToDataURL(canvas) {
    if (typeof canvas.convertToBlob === 'function') {
      const copy = document.createElement('canvas');
      copy.width = canvas.width;
      copy.height = canvas.height;
      const ctx = copy.getContext('2d');
      ctx.drawImage(canvas, 0, 0);
      return copy.toDataURL('image/png');
    }
    return canvas.toDataURL('image/png');
  }

  function setStageColor(i, hex) {
    if (!Number.isInteger(i) || i < 0) return;
    if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
      stageColorMap.set(i % STAGE_IDS.length, hex);
      invalidateSprites();
    }
  }

  function getStageColorByIndex(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return 'transparent';
    const i = Math.floor(n);
    if (i < 0) return 'transparent';
    const k = i % STAGE_IDS.length;
    return stageColorMap.get(k) || DEFAULT_STAGE_COLORS[k];
  }

  function getMetricForOmicsType(type) {
    return omicsMetric[type] || 'raw';
  }

  function collectMetricValues(nodes, omicsType, metric = null) {
    const oldMetric = omicsMetric[omicsType];
    if (metric) omicsMetric[omicsType] = metric;
    const key = metricKey(omicsType);
    if (metric) omicsMetric[omicsType] = oldMetric || 'raw';

    const values = [];
    (nodes || []).forEach(n => {
      const vals = Array.isArray(n?.[key]) ? n[key] : [];
      vals.forEach(v => {
        const num = toNum(v);
        if (Number.isFinite(num)) values.push(num);
      });
    });
    return values;
  }

  function defaultRangeForMetric(omicsType, metric) {
    // Fallback only. The real range should be read from the JSON arrays whenever possible.
    if (metric === 'norm') return [-1, 1];
    if (metric === 'zscore') return [-3, 3];

    // Raw fallback ranges. If JSON values exist, getMetricRange() uses the actual JSON range.
    if (omicsType === 'exp') return [0, 5];   // expression raw-style values
    if (omicsType === 'mty') return [0, 1];   // methylation beta values
    if (omicsType === 'cnv') return [-2, 2];  // CNV can be signed
    if (omicsType === 'snv') return [0, 1];   // SNV is often 0/1 or non-negative
    return [0, 1];
  }

  function getMetricRange(nodes, omicsType, metric = null) {
    const activeMetric = metric || getMetricForOmicsType(omicsType);

    // IMPORTANT:
    // Do not hard-code Raw as [-1, 1], and do not hard-code Z-score as [-3, 3].
    // The range displayed in the UI should come from the actual JSON field currently used:
    //   raw    -> *_vals
    //   norm   -> *_norm
    //   zscore -> *_z
    const values = collectMetricValues(nodes, omicsType, activeMetric);
    if (values.length) {
      let minV = d3.min(values);
      let maxV = d3.max(values);
      if (Number.isFinite(minV) && Number.isFinite(maxV)) {
        if (minV === maxV) {
          const pad = Math.abs(minV) > 0 ? Math.abs(minV) * 0.05 : 0.01;
          minV -= pad;
          maxV += pad;
        }
        return [minV, maxV];
      }
    }

    return defaultRangeForMetric(omicsType, activeMetric);
  }

  function getColorDomainForMetric(omicsType, metric = null) {
    const activeMetric = metric || getMetricForOmicsType(omicsType);
    const [minV0, maxV0] = getMetricRange(currentData?.nodes || [], omicsType, activeMetric);
    let minV = Number.isFinite(minV0) ? minV0 : defaultRangeForMetric(omicsType, activeMetric)[0];
    let maxV = Number.isFinite(maxV0) ? maxV0 : defaultRangeForMetric(omicsType, activeMetric)[1];

    if (minV === maxV) {
      const pad = Math.abs(minV) > 0 ? Math.abs(minV) * 0.05 : 0.01;
      minV -= pad;
      maxV += pad;
    }

    // Signed scales: z-score, min-max [-1,1], and signed raw CNV should use negative / zero / positive colors.
    if (minV < 0 && maxV > 0) {
      return [minV, 0, maxV];
    }

    // Non-negative raw scales such as expression, methylation, and SNV should NOT map the lowest value to the
    // negative color. Otherwise raw SNV=0 becomes blue. Low/zero values are handled as transparent/blank below.
    const midV = (minV + maxV) / 2;
    return [minV, midV, maxV];
  }

  function makeTransparentPositiveRawScale(omicsType, domain) {
    const minV = Number.isFinite(domain?.[0]) ? domain[0] : 0;
    const maxV = Number.isFinite(domain?.[2]) ? domain[2] : Number.isFinite(domain?.[1]) ? domain[1] : 1;
    const posColor = d3.color(d3.select(`#${omicsType}Pos`).property('value') || '#FF0000');
    const denom = maxV - minV;
    const eps = Math.max(1e-12, Math.abs(denom) * 1e-9);

    // Use a clearly visible positive gradient for raw non-negative data.
    // This is applied to exp, mty, and snv in Raw mode:
    //   exact 0 / minimum -> transparent blank
    //   low non-zero     -> light but visible positive color
    //   middle           -> medium positive color
    //   high             -> strong positive color
    // It intentionally does not use the negative color for raw non-negative values.
    const lightPositive = d3.interpolateRgb('#fff7f7', posColor.formatHex ? posColor.formatHex() : '#FF0000');

    return function rawNonNegativeColor(v) {
      const x = toNum(v);
      if (!Number.isFinite(x)) return 'transparent';

      if (x <= 0 || x <= minV + eps || !Number.isFinite(denom) || denom <= 0) {
        return 'rgba(0,0,0,0)';
      }

      let t = (x - minV) / denom;
      t = Math.max(0, Math.min(1, t));

      // Gamma < 1 makes low and middle values more visible.
      // This avoids the "mostly grey / empty" appearance for exp and mty raw rings.
      const visibleT = Math.pow(t, 0.45);
      const colorText = lightPositive(visibleT);
      const c0 = d3.color(colorText);

      // Minimum visible alpha is intentionally higher than before, so low-but-real raw values are visible.
      const alpha = 0.35 + 0.65 * Math.pow(t, 0.55);
      const c = d3.rgb(c0.r, c0.g, c0.b, alpha);
      return c.formatRgb();
    };
  }

  function makeOmicsColorScale(omicsType) {
    const metric = getMetricForOmicsType(omicsType);
    const domain = getColorDomainForMetric(omicsType, metric);

    // Raw expression / methylation / SNV are non-negative biological values.
    // They should not use the negative color at the lower bound. Instead:
    //   low or 0 -> transparent / blank
    //   higher values -> progressively stronger positive color
    // Signed modes such as z-score, min-max [-1,1], and raw CNV still use negative-zero-positive colors.
    const isRawNonNegative = metric === 'raw' && domain[0] >= 0 && omicsType !== 'cnv';
    if (isRawNonNegative) {
      return makeTransparentPositiveRawScale(omicsType, domain);
    }

    return d3.scaleLinear()
      .domain(domain)
      .range([
        d3.select(`#${omicsType}Neg`).property('value'),
        d3.select(`#${omicsType}Zero`).property('value'),
        d3.select(`#${omicsType}Pos`).property('value')
      ])
      .clamp(true);
  }

  function getColorScales() {
    ['exp', 'mty', 'cnv', 'snv'].forEach(type => {
      colorConfig[type] = makeOmicsColorScale(type);
    });

    colorConfig.edge = {
      neg: d3.select('#edgeNeg').property('value'),
      zero: d3.select('#edgeZero').property('value'),
      pos: d3.select('#edgePos').property('value')
    };
  }

  function metricKey(omicsType) {
    const metric = omicsMetric[omicsType] || 'raw';
    const suffix = metric === 'zscore' ? 'z' : metric === 'norm' ? 'norm' : 'vals';
    return `${omicsType}_${suffix}`;
  }

  function getCurrentEdgeWeight(e) {
    const edgeMetric = d3.select('#edgeMetric').property('value');
    const metricVal = toNum(e?.[edgeMetric]);
    const pearsonVal = toNum(e?.pearson ?? e?.pearson_r ?? e?.corr ?? e?.correlation ?? e?.r);
    const weightVal = toNum(e?.weight);
    if (Number.isFinite(metricVal)) return metricVal;
    if (Number.isFinite(pearsonVal)) return pearsonVal;
    if (Number.isFinite(weightVal)) return weightVal;
    return 0;
  }

  function getRawEdgeWeightForMinMax(edge) {
    // Prefer explicit directed raw weight from JSON.
    // Fall back to common correlation/weight fields only when w_raw is absent.
    const rawVal = toNum(edge?.w_raw);
    if (Number.isFinite(rawVal)) return rawVal;

    const pearsonVal = toNum(edge?.pearson ?? edge?.pearson_r ?? edge?.corr ?? edge?.correlation ?? edge?.r);
    if (Number.isFinite(pearsonVal)) return pearsonVal;

    const weightVal = toNum(edge?.weight);
    if (Number.isFinite(weightVal)) return weightVal;

    return NaN;
  }

  function recomputeDirectedEdgeMinMaxNorm(data) {
    const edges = Array.isArray(data?.edges) ? data.edges : [];
    const rawVals = edges.map(getRawEdgeWeightForMinMax).filter(Number.isFinite);

    if (!rawVals.length) return data;

    const wMin = d3.min(rawVals);
    const wMax = d3.max(rawVals);
    const denom = wMax - wMin;

    edges.forEach(edge => {
      const raw = getRawEdgeWeightForMinMax(edge);
      if (!Number.isFinite(raw)) return;

      // Preserve the original JSON-provided w_norm once for debugging/export comparison.
      if (edge._original_w_norm === undefined && edge.w_norm !== undefined) {
        edge._original_w_norm = edge.w_norm;
      }

      edge._w_raw_for_minmax = raw;
      edge._w_min_for_minmax = wMin;
      edge._w_max_for_minmax = wMax;
      edge.w_norm = denom > 0 ? (raw - wMin) / denom : 0;
    });

    return data;
  }

  function formatWeight(v) {
    if (!Number.isFinite(v)) return '';
    return v.toFixed(3);
  }

  function hasSinglecellFeature(obj) {
    if (!obj || typeof obj !== 'object') return false;

    const seen = new WeakSet();

    function scan(value, key = '') {
      const keyText = String(key || '').toLowerCase();

      // Match either a key named/containing singlecell, or a string value containing singlecell.
      // This keeps compatibility with singlecell, SingleCell, SINGLECELL, is_singlecell, etc.
      if (keyText.includes('singlecell')) {
        if (value === null || value === undefined || value === false) return false;
        if (typeof value === 'string') return value.toLowerCase().includes('singlecell');
        return true;
      }

      if (typeof value === 'string' && value.toLowerCase().includes('singlecell')) return true;

      if (Array.isArray(value)) {
        return value.some(v => scan(v));
      }

      if (value && typeof value === 'object') {
        if (seen.has(value)) return false;
        seen.add(value);
        return Object.entries(value).some(([k, v]) => scan(v, k));
      }

      return false;
    }

    return scan(obj);
  }

  function isSinglecellMode() {
    return hasSinglecellFeature(currentData);
  }

  function firstNonEmptyString(values) {
    for (const v of values) {
      if (v === null || v === undefined) continue;
      const s = String(Array.isArray(v) ? v[0] : v).trim();
      if (s && s.toLowerCase() !== 'na' && s.toLowerCase() !== 'null' && s.toLowerCase() !== 'undefined') {
        return s;
      }
    }
    return '';
  }

  function getEdgeTypeName(edge) {
    // Prefer explicit edge-name/type fields from JSON.
    // interact_id is kept first because the R exporter writes edge names from interact / interact_id into interact_id.
    return firstNonEmptyString([
      edge?.interact_id,
      edge?.interact,
      edge?.edge_name,
      edge?.edgeName,
      edge?.edge_type,
      edge?.edgeType,
      edge?.type_name,
      edge?.typeName,
      edge?.relation,
      edge?.relationship,
      edge?.name,
      edge?.label
    ]);
  }

  function buildEdgeTypeColorMap(edges) {
    const names = Array.from(new Set(
      (edges || [])
        .map(getEdgeTypeName)
        .filter(Boolean)
    )).sort(d3.ascending);

    const colorMap = new Map();
    names.forEach((name, i) => {
      colorMap.set(name, EDGE_TYPE_COLORS[i % EDGE_TYPE_COLORS.length]);
    });
    return colorMap;
  }

  function formatSinglecellEdgeLabel(edge) {
    const typeName = getEdgeTypeName(edge);
    const weightText = formatWeight(edge?._w);
    if (typeName && weightText) return `${typeName} | ${weightText}`;
    if (typeName) return typeName;
    return weightText;
  }

  function getNodeSampleCount(nodeDatum) {
    return Math.max(
      nodeDatum?.exp_vals?.length || 0,
      nodeDatum?.mty_vals?.length || 0,
      nodeDatum?.cnv_vals?.length || 0,
      nodeDatum?.snv_vals?.length || 0,
      nodeDatum?.stage_idx?.length || 0,
      1
    );
  }

  function subsetValuesByIndices(values, indices) {
    if (!Array.isArray(values)) return [];
    if (!Array.isArray(indices)) return values.slice();
    return indices.map(i => values[i]);
  }

  function isSampleSubsetDisplayEnabled() {
    return useDifferenceDisplay || useSimilarityDisplay;
  }

  function getActiveDisplayIndices() {
    if (useSimilarityDisplay) {
      return Array.isArray(globalSimilarityDisplayIndices) ? globalSimilarityDisplayIndices : [];
    }
    if (useDifferenceDisplay) {
      return Array.isArray(globalDifferenceDisplayIndices) ? globalDifferenceDisplayIndices : [];
    }
    return null;
  }

  function getDisplaySampleIndices(nodeDatum) {
    return getActiveDisplayIndices();
  }

  function getDisplayValues(nodeDatum, values) {
    const indices = getDisplaySampleIndices(nodeDatum);
    if (!indices) return Array.isArray(values) ? values : [];
    return subsetValuesByIndices(values, indices);
  }

  function getNodeTypeZArrayForSelection(node, type) {
    const zKey = `${type}_z`;
    const rawKey = `${type}_vals`;

    if (Array.isArray(node?.[zKey])) {
      return node[zKey].map(v => {
        const n = toNum(v);
        return Number.isFinite(n) ? n : NaN;
      });
    }

    if (!Array.isArray(node?.[rawKey])) return [];

    const raw = node[rawKey].map(toNum);
    const nums = raw.filter(Number.isFinite);
    if (nums.length < 2) return raw.map(() => NaN);

    const stats = meanAndSd(nums);
    return raw.map(v => {
      if (!Number.isFinite(v) || !Number.isFinite(stats.mean) || !Number.isFinite(stats.sd) || stats.sd === 0) return NaN;
      return (v - stats.mean) / stats.sd;
    });
  }

  function buildSampleFeatureRows(nodes) {
    if (!Array.isArray(nodes) || !nodes.length) return [];

    const omicsTypes = ['exp', 'mty', 'cnv', 'snv'];
    const count = d3.max(nodes, getNodeSampleCount) || 0;
    if (!count) return [];

    const zCache = new WeakMap();
    function getZ(node, type) {
      if (!zCache.has(node)) zCache.set(node, new Map());
      const cache = zCache.get(node);
      if (!cache.has(type)) cache.set(type, getNodeTypeZArrayForSelection(node, type));
      return cache.get(type);
    }

    function mode(values) {
      const counts = new Map();
      values.forEach(v => {
        const n = Math.floor(+v);
        if (!Number.isFinite(n) || n < 0) return;
        counts.set(n, (counts.get(n) || 0) + 1);
      });
      let best = null;
      let bestCount = -1;
      counts.forEach((count, key) => {
        if (count > bestCount || (count === bestCount && (best == null || key < best))) {
          best = key;
          bestCount = count;
        }
      });
      return best;
    }

    const rows = [];

    for (let sampleIndex = 0; sampleIndex < count; sampleIndex++) {
      const stageVotes = [];
      nodes.forEach(node => {
        const stageArr = Array.isArray(node?.stage_idx) ? node.stage_idx : [];
        const v = toNum(stageArr[sampleIndex]);
        if (Number.isFinite(v)) stageVotes.push(v);
      });
      const stage = mode(stageVotes);

      const G = [];
      const L = [];

      omicsTypes.forEach(type => {
        const vals = [];
        nodes.forEach(node => {
          const zArr = getZ(node, type);
          const z = toNum(zArr[sampleIndex]);
          if (Number.isFinite(z)) vals.push(z);
        });

        if (!vals.length) {
          G.push(0);
          L.push(0);
          return;
        }

        const globalMean = d3.mean(vals);
        G.push(Number.isFinite(globalMean) ? globalMean : 0);

        const absVals = vals.map(v => Math.abs(v)).sort(d3.ascending);
        const q75 = d3.quantileSorted(absVals, 0.75);
        const cutoff = Number.isFinite(q75) ? q75 : 0;
        const localVals = vals.filter(v => Math.abs(v) >= cutoff);
        const localMean = localVals.length ? d3.mean(localVals) : globalMean;
        L.push(Number.isFinite(localMean) ? localMean : 0);
      });

      const Z = G.map((g, i) => 0.60 * g + 0.40 * L[i]);
      rows.push({ index: sampleIndex, stage, G, L, Z });
    }

    return rows;
  }

  function euclideanDistance(a, b) {
    const n = Math.min(a?.length || 0, b?.length || 0);
    if (!n) return 0;
    let sum = 0;
    for (let i = 0; i < n; i++) {
      const av = Number.isFinite(a[i]) ? a[i] : 0;
      const bv = Number.isFinite(b[i]) ? b[i] : 0;
      const d = av - bv;
      sum += d * d;
    }
    return Math.sqrt(sum);
  }

  function cosineDistance01(a, b) {
    const n = Math.min(a?.length || 0, b?.length || 0);
    if (!n) return 0;
    let dot = 0;
    let na = 0;
    let nb = 0;
    for (let i = 0; i < n; i++) {
      const av = Number.isFinite(a[i]) ? a[i] : 0;
      const bv = Number.isFinite(b[i]) ? b[i] : 0;
      dot += av * bv;
      na += av * av;
      nb += bv * bv;
    }
    if (na <= 0 || nb <= 0) return 0;
    const cos = Math.max(-1, Math.min(1, dot / (Math.sqrt(na) * Math.sqrt(nb))));
    return (1 - cos) / 2;
  }

  function buildMixedDistanceMatrix(sampleRows) {
    const n = sampleRows.length;
    const euc = Array.from({ length: n }, () => Array(n).fill(0));
    const cos = Array.from({ length: n }, () => Array(n).fill(0));
    const mix = Array.from({ length: n }, () => Array(n).fill(0));

    let maxEuc = 0;
    for (let i = 0; i < n; i++) {
      for (let j = i + 1; j < n; j++) {
        const de = euclideanDistance(sampleRows[i].Z, sampleRows[j].Z);
        const dc = cosineDistance01(sampleRows[i].Z, sampleRows[j].Z);
        euc[i][j] = euc[j][i] = de;
        cos[i][j] = cos[j][i] = dc;
        if (de > maxEuc) maxEuc = de;
      }
    }

    if (!Number.isFinite(maxEuc) || maxEuc <= 0) maxEuc = 1;

    for (let i = 0; i < n; i++) {
      for (let j = i + 1; j < n; j++) {
        const dEucNorm = euc[i][j] / maxEuc;
        const dMix = 0.60 * dEucNorm + 0.40 * cos[i][j];
        mix[i][j] = mix[j][i] = Number.isFinite(dMix) ? dMix : 0;
      }
    }

    return mix;
  }

  function selectDifferenceByMaxMin(poolRows, k) {
    if (!Array.isArray(poolRows) || !poolRows.length) return [];
    const K = Math.min(k, poolRows.length);
    if (K <= 1) return poolRows.slice(0, K);

    const D = buildMixedDistanceMatrix(poolRows);
    let bestI = 0;
    let bestJ = 1;
    let bestD = -Infinity;

    for (let i = 0; i < poolRows.length; i++) {
      for (let j = i + 1; j < poolRows.length; j++) {
        if (D[i][j] > bestD) {
          bestD = D[i][j];
          bestI = i;
          bestJ = j;
        }
      }
    }

    const selected = [bestI, bestJ];
    const selectedSet = new Set(selected);

    while (selected.length < K) {
      let bestCandidate = -1;
      let bestMinDist = -Infinity;

      for (let i = 0; i < poolRows.length; i++) {
        if (selectedSet.has(i)) continue;
        const minDist = d3.min(selected.map(j => D[i][j]));
        if (minDist > bestMinDist || (minDist === bestMinDist && poolRows[i].index < (poolRows[bestCandidate]?.index ?? Infinity))) {
          bestMinDist = minDist;
          bestCandidate = i;
        }
      }

      if (bestCandidate < 0) break;
      selected.push(bestCandidate);
      selectedSet.add(bestCandidate);
    }

    return selected.map(i => poolRows[i]);
  }

  function selectSimilarityByAverageDistance(poolRows, k) {
    if (!Array.isArray(poolRows) || !poolRows.length) return [];
    const K = Math.min(k, poolRows.length);
    if (K <= 1) return poolRows.slice(0, K);

    const D = buildMixedDistanceMatrix(poolRows);
    let bestI = 0;
    let bestJ = 1;
    let bestD = Infinity;

    for (let i = 0; i < poolRows.length; i++) {
      for (let j = i + 1; j < poolRows.length; j++) {
        if (D[i][j] < bestD) {
          bestD = D[i][j];
          bestI = i;
          bestJ = j;
        }
      }
    }

    const selected = [bestI, bestJ];
    const selectedSet = new Set(selected);

    while (selected.length < K) {
      let bestCandidate = -1;
      let bestAvgDist = Infinity;

      for (let i = 0; i < poolRows.length; i++) {
        if (selectedSet.has(i)) continue;
        const avgDist = d3.mean(selected.map(j => D[i][j]));
        if (avgDist < bestAvgDist || (avgDist === bestAvgDist && poolRows[i].index < (poolRows[bestCandidate]?.index ?? Infinity))) {
          bestAvgDist = avgDist;
          bestCandidate = i;
        }
      }

      if (bestCandidate < 0) break;
      selected.push(bestCandidate);
      selectedSet.add(bestCandidate);
    }

    return selected.map(i => poolRows[i]);
  }

  function groupRowsForDisplaySelection(sampleRows) {
    const validStages = Array.from(new Set(sampleRows.map(d => d.stage).filter(Number.isFinite))).sort(d3.ascending);
    if (validStages.length >= 1) {
      return validStages.map(stage => sampleRows.filter(d => d.stage === stage));
    }
    return [sampleRows];
  }

  function getDisplaySampleCount(inputSelector, fallback = 8) {
    const input = d3.select(inputSelector);
    let v = input.empty() ? fallback : +input.property('value');
    if (!Number.isFinite(v)) v = fallback;
    v = Math.round(v);
    v = Math.max(1, Math.min(100, v));
    if (!input.empty()) input.property('value', v);
    return v;
  }

  function computeGlobalDifferenceDisplayIndices(nodes) {
    const sampleRows = buildSampleFeatureRows(nodes);
    if (!sampleRows.length) return [];

    const selected = [];
    const requestedK = getDisplaySampleCount('#differenceSampleCount', 8);
    groupRowsForDisplaySelection(sampleRows).forEach(pool => {
      const K = Math.min(requestedK, pool.length);
      selected.push(...selectDifferenceByMaxMin(pool, K));
    });

    return Array.from(new Set(selected.map(d => d.index))).sort(d3.ascending);
  }

  function computeGlobalSimilarityDisplayIndices(nodes) {
    const sampleRows = buildSampleFeatureRows(nodes);
    if (!sampleRows.length) return [];

    const selected = [];
    const requestedK = getDisplaySampleCount('#similaritySampleCount', 8);
    groupRowsForDisplaySelection(sampleRows).forEach(pool => {
      const K = Math.min(requestedK, pool.length);
      selected.push(...selectSimilarityByAverageDistance(pool, K));
    });

    return Array.from(new Set(selected.map(d => d.index))).sort(d3.ascending);
  }

  function getValueRange(nodes, omicsType) {
    const metric = getMetricForOmicsType(omicsType);
    const [minV, maxV] = getMetricRange(nodes, omicsType, metric);
    const midV = (minV < 0 && maxV > 0) ? 0 : (minV + maxV) / 2;
    return [minV, midV, maxV];
  }

  function updateValueRangeInputs(nodes) {
    const omicsType = d3.select('#omicsType').property('value');
    const metric = getMetricForOmicsType(omicsType);
    const [vmin, vzero, vmax] = getValueRange(nodes, omicsType);

    // Use actual JSON range for every mode:
    // Raw    -> actual *_vals range
    // Norm   -> actual *_norm range, usually [-1, 1]
    // Zscore -> actual *_z range, can exceed [-3, 3]
    const digits = metric === 'raw' ? 3 : 2;
    d3.select('#rangeMin').property('value', Number(vmin).toFixed(digits));
    d3.select('#rangeMax').property('value', Number(vmax).toFixed(digits));

    // Rebuild all omics color scales because each ring has its own selected metric and its own actual JSON range.
    getColorScales();
  }

  function quantileRange(values, qLow = 0.05, qHigh = 0.95) {
    const arr = values.map(toNum).filter(Number.isFinite).sort(d3.ascending);
    if (arr.length < 3) return 0;
    const lo = d3.quantileSorted(arr, qLow);
    const hi = d3.quantileSorted(arr, qHigh);
    if (!Number.isFinite(lo) || !Number.isFinite(hi)) return 0;
    return hi - lo;
  }

  function robustNodeRangeZ(node, omicsType, sampleIndices = null) {
    const vals0 = Array.isArray(node?.[`${omicsType}_vals`]) ? node[`${omicsType}_vals`] : [];
    const allNums = vals0.map(toNum).filter(Number.isFinite);
    if (allNums.length < 3) return 0;

    const stats = meanAndSd(allNums);
    if (!Number.isFinite(stats.mean) || !Number.isFinite(stats.sd) || stats.sd === 0) return 0;

    const displayVals = Array.isArray(sampleIndices) ? sampleIndices.map(i => vals0[i]) : vals0;
    const zVals = displayVals.map(toNum).filter(Number.isFinite).map(v => (v - stats.mean) / stats.sd);
    if (zVals.length < 3) return 0;
    return quantileRange(zVals, 0.05, 0.95);
  }

  // -----------------------------
  // Pattern Discovery helpers
  // -----------------------------
  function scanNodesForRealGroupData(nodes) {
    const groups = new Set();
    (nodes || []).forEach(node => {
      const arr = Array.isArray(node?.stage_idx) ? node.stage_idx : [];
      arr.forEach(v => {
        const n = toNum(v);
        if (!Number.isFinite(n) || n < 0) return;
        groups.add(Math.floor(n));
      });
    });
    return groups.size >= 2;
  }

  function hasUsableStageData(dataOrNodes) {
    // Prefer explicit metadata generated by the R exporter.
    // This avoids treating a fallback single group value such as all 0 as real stage data.
    const data = (!Array.isArray(dataOrNodes) && dataOrNodes && typeof dataOrNodes === 'object')
      ? dataOrNodes
      : currentData;

    if (data && data.stage_metadata && typeof data.stage_metadata.has_real_stage_group === 'boolean') {
      return data.stage_metadata.has_real_stage_group;
    }
    if (data && typeof data.has_real_stage_group === 'boolean') {
      return data.has_real_stage_group;
    }

    const nodes = Array.isArray(dataOrNodes) ? dataOrNodes : (dataOrNodes?.nodes || data?.nodes || []);
    return scanNodesForRealGroupData(nodes);
  }

  function setPatternDiscoverySubrowDisabled(rowSelector, disabled) {
    const row = d3.select(rowSelector);
    if (row.empty()) return;
    row.classed('pattern-discovery-disabled', !!disabled);
    row.selectAll('input, select, button').property('disabled', !!disabled);
  }

  function updatePatternDiscoveryControlsForData(data) {
    const nodes = Array.isArray(data?.nodes) ? data.nodes : [];
    const hasStage = hasUsableStageData(data);

    setPatternDiscoverySubrowDisabled('#patternStageAwareRow', !hasStage);
    setPatternDiscoverySubrowDisabled('#patternStageFreeRow', hasStage);

    const modeText = hasStage
      ? 'group-aware mode: TrendScore + GroupScore'
      : 'group-free mode: GlobalPatternRate + GroupScore';
    d3.select('#patternDiscoveryModeStatus').text(modeText);

    updatePatternThresholdRanges(data, true);

    if (!usePatternDiscovery) {
      d3.select('#patternDiscoveryStatus').text('');
    }
  }

  function getPatternDiscoverySettings() {
    const expHigh = +d3.select('#patternExpHighThresholdValue').property('value');
    const expLow = +d3.select('#patternExpLowThresholdValue').property('value');
    const mtyHigh = +d3.select('#patternMtyHighThresholdValue').property('value');
    const mtyLow = +d3.select('#patternMtyLowThresholdValue').property('value');
    return {
      // Pattern Discovery is intentionally fixed to gene-wise JSON Z-score.
      // Hit selection and score intensity both use exp_z/mty_z to avoid mixing raw, min-max, and z-score thresholds.
      scale: 'zscore',
      expHighT: Number.isFinite(expHigh) ? expHigh : 0,
      expLowT: Number.isFinite(expLow) ? expLow : 0,
      mtyHighT: Number.isFinite(mtyHigh) ? mtyHigh : 0,
      mtyLowT: Number.isFinite(mtyLow) ? mtyLow : 0,
      finalTrendMin: Math.max(0, +d3.select('#patternFinalTrendValue').property('value') || 0),
      stageEvidenceMin: Math.max(0, +d3.select('#patternStageEvidenceValue').property('value') || 0),
      globalRateMin: Math.max(0, +d3.select('#patternGlobalRateValue').property('value') || 0),
      freeEvidenceMin: Math.max(0, +d3.select('#patternFreeEvidenceValue').property('value') || 0),
    };
  }

  function numericArray(values) {
    return Array.isArray(values)
      ? values.map(toNum).map(v => Number.isFinite(v) ? v : NaN)
      : [];
  }

  function getCachedNumericNodeArray(node, key) {
    if (!node || typeof node !== 'object') return [];
    if (!node._patternNumericCache) {
      Object.defineProperty(node, '_patternNumericCache', {
        value: new Map(),
        enumerable: false,
        configurable: true,
      });
    }
    const cache = node._patternNumericCache;
    if (cache.has(key)) return cache.get(key);
    const arr = numericArray(node?.[key]);
    cache.set(key, arr);
    return arr;
  }

  function meanSdFromNumericArray(arr) {
    const nums = arr.filter(Number.isFinite);
    if (!nums.length) return { mean: NaN, sd: NaN };
    const mean = d3.mean(nums);
    let sd = d3.deviation(nums);
    if (!Number.isFinite(sd) || sd === 0) sd = 1;
    return { mean, sd };
  }

  function formatPatternRangeValue(v, digits = 2) {
    const n = toNum(v);
    if (!Number.isFinite(n)) return 'NA';
    // Always use fixed decimals for UI threshold ranges to avoid scientific notation
    // such as 1.07e-5. For example, 0.0000107 is displayed as 0.00.
    return n.toFixed(digits);
  }

  function metricFieldForPatternScale(type, scale) {
    // Pattern Discovery always uses gene-wise JSON Z-score fields.
    // Raw and Min-Max remain available for normal Data rendering/filtering only.
    return `${type}_z`;
  }

  function patternScaleLabel(scale) {
    return 'z';
  }

  function getPatternMappedValuesForDirection(nodes, type, direction, cutoff, scale = 'zscore') {
    // Pattern Discovery hit selection uses JSON Z-score fields only.
    // The mapped raw/min-max ranges are shown only as references by the same sample index.
    const selectedVals = [];
    const zVals = [];
    const rawVals = [];
    const normVals = [];
    const field = metricFieldForPatternScale(type, scale);

    (nodes || []).forEach(node => {
      const selected = getCachedNumericNodeArray(node, field);
      const z = getCachedNumericNodeArray(node, `${type}_z`);
      const raw = getCachedNumericNodeArray(node, `${type}_vals`);
      const norm = getCachedNumericNodeArray(node, `${type}_norm`);
      const n = Math.max(selected.length, z.length, raw.length, norm.length);

      for (let i = 0; i < n; i++) {
        const sv = toNum(selected[i]);
        if (!Number.isFinite(sv)) continue;
        const pass = direction === 'high' ? sv >= cutoff : sv <= cutoff;
        if (!pass) continue;

        selectedVals.push(sv);
        const zv = toNum(z[i]);
        const rv = toNum(raw[i]);
        const nv = toNum(norm[i]);
        if (Number.isFinite(zv)) zVals.push(zv);
        if (Number.isFinite(rv)) rawVals.push(rv);
        if (Number.isFinite(nv)) normVals.push(nv);
      }
    });

    return { selectedVals, zVals, rawVals, normVals };
  }

  function rangeTextFromArray(values, digits = 2) {
    const arr = (values || []).map(toNum).filter(Number.isFinite);
    if (!arr.length) return 'NA';
    return `${formatPatternRangeValue(d3.min(arr), digits)} – ${formatPatternRangeValue(d3.max(arr), digits)}`;
  }

  function getAllMetricRangeForType(nodes, type, scale = 'zscore') {
    const vals = [];
    const field = metricFieldForPatternScale(type, scale);
    (nodes || []).forEach(node => {
      const arr = getCachedNumericNodeArray(node, field);
      arr.forEach(v => { if (Number.isFinite(toNum(v))) vals.push(toNum(v)); });
    });
    if (!vals.length) return { min: -1, max: 1 };
    return { min: d3.min(vals), max: d3.max(vals) };
  }

  function updatePatternThresholdRanges(data, preserveCurrent = true) {
    const nodes = Array.isArray(data?.nodes) ? data.nodes : [];

    function roundDown2(v) { return Math.floor(v * 100) / 100; }
    function roundUp2(v) { return Math.ceil(v * 100) / 100; }

    function setPair(sliderSel, inputSel, minVal, maxVal, defaultValue) {
      const slider = d3.select(sliderSel);
      const input = d3.select(inputSel);
      if (slider.empty() || input.empty()) return defaultValue;

      let minFixed = roundDown2(Number.isFinite(minVal) ? minVal : -1);
      let maxFixed = roundUp2(Number.isFinite(maxVal) ? maxVal : 1);
      if (minFixed === maxFixed) {
        minFixed -= 0.01;
        maxFixed += 0.01;
      }

      let current = preserveCurrent ? +input.property('value') : defaultValue;
      if (!Number.isFinite(current)) current = defaultValue;
      current = Math.max(minFixed, Math.min(maxFixed, current));

      slider
        .attr('min', minFixed.toFixed(2))
        .attr('max', maxFixed.toFixed(2))
        .attr('step', '0.01')
        .property('min', minFixed.toFixed(2))
        .property('max', maxFixed.toFixed(2))
        .property('step', '0.01')
        .property('value', current.toFixed(2));

      input
        .attr('min', minFixed.toFixed(2))
        .attr('max', maxFixed.toFixed(2))
        .attr('step', '0.01')
        .property('min', minFixed.toFixed(2))
        .property('max', maxFixed.toFixed(2))
        .property('step', '0.01')
        .property('value', current.toFixed(2));

      return current;
    }

    function formatMappedHint(labelPrefix, compareText, mapped, scale) {
      if (!mapped.selectedVals.length) return `[${labelPrefix} | ${compareText} | no matched samples]`;

      const selectedLabel = patternScaleLabel(scale);
      const selectedText = `${selectedLabel}: ${rangeTextFromArray(mapped.selectedVals)}`;
      const zText = `z: ${rangeTextFromArray(mapped.zVals)}`;
      const rawText = `raw: ${rangeTextFromArray(mapped.rawVals)}`;
      const normText = `min-max: ${rangeTextFromArray(mapped.normVals)}`;

      let ordered;
      if (scale === 'raw') ordered = [selectedText, zText, normText];
      else if (scale === 'norm') ordered = [selectedText, zText, rawText];
      else ordered = [selectedText, rawText, normText];
      return `[${labelPrefix} | ${compareText} | ${ordered.join(' | ')}]`;
    }

    function apply(type, direction, sliderSel, inputSel, labelSel, defaultValue) {
      const scale = 'zscore';
      const r = getAllMetricRangeForType(nodes, type, scale);
      const minVal = Number.isFinite(r.min) ? r.min : -1;
      const maxVal = Number.isFinite(r.max) ? r.max : 1;

      const controlMin = direction === 'high' ? Math.min(0, maxVal) : minVal;
      const controlMax = direction === 'high' ? maxVal : Math.max(0, minVal);
      const current = setPair(sliderSel, inputSel, controlMin, controlMax, defaultValue);

      const mapped = getPatternMappedValuesForDirection(nodes, type, direction, current, scale);
      const labelPrefix = direction === 'high'
        ? `${type === 'exp' ? 'Data1' : 'Data2'} high mapped range`
        : `${type === 'exp' ? 'Data1' : 'Data2'} low mapped range`;
      const compareSymbol = direction === 'high' ? '≥' : '≤';
      const compareText = `${patternScaleLabel(scale)} ${compareSymbol} ${formatPatternRangeValue(current, 2)}`;

      const text = formatMappedHint(labelPrefix, compareText, mapped, scale);
      d3.select(labelSel).text(text);
    }

    apply('exp', 'high', '#patternExpHighThresholdSlider', '#patternExpHighThresholdValue', '#patternExpHighThresholdRange', 0.00);
    apply('exp', 'low', '#patternExpLowThresholdSlider', '#patternExpLowThresholdValue', '#patternExpLowThresholdRange', 0.00);
    apply('mty', 'high', '#patternMtyHighThresholdSlider', '#patternMtyHighThresholdValue', '#patternMtyHighThresholdRange', 0.00);
    apply('mty', 'low', '#patternMtyLowThresholdSlider', '#patternMtyLowThresholdValue', '#patternMtyLowThresholdRange', 0.00);
  }

  function getNodeMetricArrayForPattern(node, type, scale) {
    // Pattern Discovery uses z-score only. Prefer JSON *_z; if absent, compute z-score from *_vals.
    const z = getCachedNumericNodeArray(node, `${type}_z`);
    if (z.length) return z;
    const raw = getCachedNumericNodeArray(node, `${type}_vals`);
    const stats = meanSdFromNumericArray(raw);
    return raw.map(v => Number.isFinite(v) ? (v - stats.mean) / stats.sd : NaN);
  }

  function getNodeZArrayForPatternIntensity(node, type) {
    const z = getCachedNumericNodeArray(node, `${type}_z`);
    if (z.length) return z;
    const raw = getCachedNumericNodeArray(node, `${type}_vals`);
    const stats = meanSdFromNumericArray(raw);
    return raw.map(v => Number.isFinite(v) ? (v - stats.mean) / stats.sd : NaN);
  }

  function classifyPatternValue(value, arr, threshold, scale) {
    // Pattern hit classification is z-score only:
    // high if z >= +threshold, low if z <= -threshold, neutral otherwise.
    const v = toNum(value);
    if (!Number.isFinite(v)) return 0;
    const t = Math.abs(threshold);
    if (v >= t) return 1;
    if (v <= -t) return -1;
    return 0;
  }

  function rankArray(values) {
    const arr = values.map(toNum);
    const indexed = arr
      .map((v, i) => ({ v, i }))
      .filter(d => Number.isFinite(d.v))
      .sort((a, b) => d3.ascending(a.v, b.v));

    const ranks = new Array(arr.length).fill(NaN);
    let i = 0;
    while (i < indexed.length) {
      let j = i + 1;
      while (j < indexed.length && indexed[j].v === indexed[i].v) j += 1;
      const avgRank = (i + 1 + j) / 2;
      for (let k = i; k < j; k++) ranks[indexed[k].i] = avgRank;
      i = j;
    }
    return ranks;
  }

  function safeSpearmanJS(x, y) {
    const rx = rankArray(x);
    const ry = rankArray(y);
    const pairs = rx.map((v, i) => [v, ry[i]])
      .filter(([a, b]) => Number.isFinite(a) && Number.isFinite(b));
    if (pairs.length < 3) return NaN;

    const xs = pairs.map(d => d[0]);
    const ys = pairs.map(d => d[1]);
    const mx = d3.mean(xs);
    const my = d3.mean(ys);
    const sx = d3.deviation(xs);
    const sy = d3.deviation(ys);
    if (!Number.isFinite(sx) || !Number.isFinite(sy) || sx === 0 || sy === 0) return 0;

    const cov = d3.mean(pairs.map(([a, b]) => (a - mx) * (b - my)));
    const r = cov / (sx * sy);
    return Number.isFinite(r) ? r : NaN;
  }

  function normalizeNonnegativeByMaxJS(values) {
    const arr = values.map(toNum);
    const finite = arr.filter(v => Number.isFinite(v) && v >= 0);
    const mx = d3.max(finite);
    if (!Number.isFinite(mx) || mx <= 0) return arr.map(() => 0);
    return arr.map(v => Number.isFinite(v) && v >= 0 ? v / mx : 0);
  }

  function calculatePatternMetricsForNode(node, settings) {
    // Hit selection uses the threshold data type selected by the user:
    //   raw    -> exp_vals / mty_vals
    //   zscore -> exp_z    / mty_z
    //   norm   -> exp_norm / mty_norm
    // Score intensity is still always calculated from JSON exp_z/mty_z.
    const expMetric = getNodeMetricArrayForPattern(node, 'exp', settings.scale || 'zscore');
    const mtyMetric = getNodeMetricArrayForPattern(node, 'mty', settings.scale || 'zscore');
    const expZ = getNodeZArrayForPatternIntensity(node, 'exp');
    const mtyZ = getNodeZArrayForPatternIntensity(node, 'mty');
    const stageArr = numericArray(node?.stage_idx);

    const n = Math.max(expMetric.length, mtyMetric.length, expZ.length, mtyZ.length);
    const hits = [];
    const antiIntensity = [];
    const validIdx = [];

    for (let i = 0; i < n; i++) {
      const ev = expMetric[i];
      const mv = mtyMetric[i];
      const ez = expZ[i];
      const mz = mtyZ[i];

      const expHigh = Number.isFinite(ev) && ev >= settings.expHighT;
      const expLow = Number.isFinite(ev) && ev <= settings.expLowT;
      const mtyHigh = Number.isFinite(mv) && mv >= settings.mtyHighT;
      const mtyLow = Number.isFinite(mv) && mv <= settings.mtyLowT;

      const hit = (expHigh && mtyLow) || (expLow && mtyHigh);
      const intensity = hit && Number.isFinite(ez) && Number.isFinite(mz) && ez * mz < 0
        ? Math.abs(ez * mz)
        : 0;

      if (Number.isFinite(ev) && Number.isFinite(mv) && Number.isFinite(ez) && Number.isFinite(mz)) {
        validIdx.push(i);
        hits[i] = hit ? 1 : 0;
        antiIntensity[i] = intensity;
      } else {
        hits[i] = NaN;
        antiIntensity[i] = NaN;
      }
    }

    const globalPatternRate = validIdx.length ? d3.mean(validIdx.map(i => hits[i])) : NaN;
    const globalAntiScore = validIdx.length ? d3.mean(validIdx.map(i => antiIntensity[i]).filter(Number.isFinite)) : NaN;

    const hasStage = stageArr.some(v => Number.isFinite(v));
    const result = {
      hasStage,
      global_pattern_rate_dynamic: globalPatternRate,
      global_anti_score_dynamic: globalAntiScore,
      global_evidence_dynamic: NaN,
      final_trend_score_dynamic: NaN,
      pattern_trend_dynamic: NaN,
      expression_methylation_anti_trend_dynamic: NaN,
      stage_pattern_metrics_dynamic: [],
    };

    if (!hasStage) return result;

    const stageLevels = Array.from(new Set(stageArr.filter(Number.isFinite).map(v => Math.floor(v)))).sort(d3.ascending);
    const patternRate = [];
    const antiScore = [];
    const avgExpZ = [];
    const avgMtyZ = [];
    const nSamples = [];

    stageLevels.forEach(stage => {
      const idx = validIdx.filter(i => Math.floor(stageArr[i]) === stage);
      nSamples.push(idx.length);
      patternRate.push(idx.length ? d3.mean(idx.map(i => hits[i])) : NaN);
      antiScore.push(idx.length ? d3.mean(idx.map(i => antiIntensity[i]).filter(Number.isFinite)) : NaN);
      avgExpZ.push(idx.length ? d3.mean(idx.map(i => expZ[i]).filter(Number.isFinite)) : NaN);
      avgMtyZ.push(idx.length ? d3.mean(idx.map(i => mtyZ[i]).filter(Number.isFinite)) : NaN);
    });

    const normAnti = normalizeNonnegativeByMaxJS(antiScore);
    const stageEvidence = patternRate.map((rate, i) => {
      const r = Number.isFinite(rate) ? Math.max(0, rate) : 0;
      const a = Number.isFinite(normAnti[i]) ? Math.max(0, normAnti[i]) : 0;
      return Math.sqrt(a * r);
    });

    const patternTrend = safeSpearmanJS(stageLevels, stageEvidence);
    const expTrend = safeSpearmanJS(stageLevels, avgExpZ);
    const mtyTrend = safeSpearmanJS(stageLevels, avgMtyZ);
    const expMtyAntiTrend =
      Math.max(0, Number.isFinite(expTrend) ? expTrend : 0) * Math.max(0, Number.isFinite(mtyTrend) ? -mtyTrend : 0) +
      Math.max(0, Number.isFinite(expTrend) ? -expTrend : 0) * Math.max(0, Number.isFinite(mtyTrend) ? mtyTrend : 0);

    const finalTrendScore =
      0.5 * Math.max(0, Number.isFinite(patternTrend) ? patternTrend : 0) +
      0.5 * (Number.isFinite(expMtyAntiTrend) ? expMtyAntiTrend : 0);

    const globalEvidence = stageEvidence.filter(Number.isFinite).length ? d3.mean(stageEvidence.filter(Number.isFinite)) : NaN;

    result.pattern_trend_dynamic = patternTrend;
    result.exp_trend_dynamic = expTrend;
    result.mty_trend_dynamic = mtyTrend;
    result.expression_methylation_anti_trend_dynamic = expMtyAntiTrend;
    result.final_trend_score_dynamic = finalTrendScore;
    result.global_evidence_dynamic = globalEvidence;
    result.stage_pattern_metrics_dynamic = stageLevels.map((stage, i) => ({
      stage,
      n_samples: nSamples[i],
      pattern_rate: patternRate[i],
      gene_anti_score: antiScore[i],
      norm_anti_score: normAnti[i],
      stage_evidence: stageEvidence[i],
      avg_exp_z: avgExpZ[i],
      avg_mty_z: avgMtyZ[i],
    }));

    return result;
  }

  function restorePatternDiscoverySetsFromData(data) {
    // Keep the existing Pattern Discovery subgraph after style-only refreshes,
    // graph drag events, or number-input spinner changes. Do not recompute or
    // clear matched nodes/edges when the thresholds did not change.
    patternDiscoveryNodeIds = new Set();
    patternDiscoveryEdgeIds = new Set();

    const nodes = Array.isArray(data?.nodes) ? data.nodes : [];
    const edges = Array.isArray(data?.edges) ? data.edges : [];

    nodes.forEach(node => {
      if (node && node._patternDiscoveryMatched) {
        patternDiscoveryNodeIds.add(String(node.id));
      }
    });

    edges.forEach(edge => {
      const s = endpointId(edge.source);
      const t = endpointId(edge.target);
      const matched = patternDiscoveryNodeIds.has(s) && patternDiscoveryNodeIds.has(t);
      edge._patternDiscoveryMatched = matched;
      edge._patternDiscoveryEdgeKey = patternEdgeKey(edge);
      if (matched) patternDiscoveryEdgeIds.add(edge._patternDiscoveryEdgeKey);
    });

    const hasStage = hasUsableStageData(currentData || { nodes });
    patternDiscoveryInfo = {
      mode: hasStage ? 'group-aware' : 'group-free',
      matchedNodes: patternDiscoveryNodeIds.size,
      matchedEdges: patternDiscoveryEdgeIds.size,
      totalNodes: nodes.length,
      totalEdges: edges.length,
    };

    const settings = getPatternDiscoverySettings();
    const scaleLabel = `threshold=${patternScaleLabel(settings.scale)}; intensity=JSON z-score`;
    const scoreText = hasStage
      ? `Pattern Discovery (${scaleLabel}, group-aware): ${patternDiscoveryInfo.matchedNodes}/${patternDiscoveryInfo.totalNodes} nodes, ${patternDiscoveryInfo.matchedEdges} edges`
      : `Pattern Discovery (${scaleLabel}, group-free): ${patternDiscoveryInfo.matchedNodes}/${patternDiscoveryInfo.totalNodes} nodes, ${patternDiscoveryInfo.matchedEdges} edges`;
    d3.select('#patternDiscoveryStatus').text(scoreText);
  }

  function resetPatternDiscoveryState(data) {
    patternDiscoveryNodeIds = new Set();
    patternDiscoveryEdgeIds = new Set();
    patternDiscoveryInfo = {
      mode: 'unknown',
      matchedNodes: 0,
      matchedEdges: 0,
      totalNodes: data?.nodes?.length || 0,
      totalEdges: data?.edges?.length || 0,
    };
  }

  function computePatternDiscoveryState(data) {
    if (!usePatternDiscovery || !data || !Array.isArray(data.nodes)) {
      resetPatternDiscoveryState(data);
      d3.select('#patternDiscoveryStatus').text('');
      return;
    }

    const settings = getPatternDiscoverySettings();
    updatePatternThresholdRanges(data, true);
    const hasStage = hasUsableStageData(data);
    const signature = [
      currentCommId || '',
      data.nodes.length,
      (data.edges || []).length,
      hasStage ? 'stage' : 'free',
      settings.scale,
      settings.expHighT,
      settings.expLowT,
      settings.mtyHighT,
      settings.mtyLowT,
      settings.finalTrendMin,
      settings.stageEvidenceMin,
      settings.globalRateMin,
      settings.freeEvidenceMin,
      usePatternDiscovery ? 1 : 0,
    ].join('|');

    if (signature === patternDiscoveryLastSignature && data.nodes.every(n => n._patternDiscoveryMetrics)) {
      restorePatternDiscoverySetsFromData(data);
      return;
    }
    patternDiscoveryLastSignature = signature;

    // Thresholds changed or the graph changed: recompute the Pattern Discovery state.
    patternDiscoveryNodeIds = new Set();
    patternDiscoveryEdgeIds = new Set();
    patternDiscoveryInfo = {
      mode: 'unknown',
      matchedNodes: 0,
      matchedEdges: 0,
      totalNodes: data?.nodes?.length || 0,
      totalEdges: data?.edges?.length || 0,
    };

    const metricsById = new Map();

    data.nodes.forEach(node => {
      const metrics = calculatePatternMetricsForNode(node, settings);
      metricsById.set(String(node.id), metrics);
      node._patternDiscoveryMetrics = metrics;
      node._patternDiscoveryMatched = false;
    });

    if (!hasStage) {
      const antiScores = Array.from(metricsById.values())
        .map(m => m.global_anti_score_dynamic)
        .filter(Number.isFinite);
      const maxAntiScore = d3.max(antiScores);

      data.nodes.forEach(node => {
        const metrics = metricsById.get(String(node.id));
        const normAnti = Number.isFinite(maxAntiScore) && maxAntiScore > 0 && Number.isFinite(metrics.global_anti_score_dynamic)
          ? metrics.global_anti_score_dynamic / maxAntiScore
          : 0;
        const rate = Number.isFinite(metrics.global_pattern_rate_dynamic) ? metrics.global_pattern_rate_dynamic : 0;
        metrics.norm_global_anti_score_dynamic = normAnti;
        metrics.global_evidence_dynamic = Math.sqrt(Math.max(0, normAnti) * Math.max(0, rate));

        const matched =
          rate >= settings.globalRateMin &&
          metrics.global_evidence_dynamic >= settings.freeEvidenceMin;

        node._patternDiscoveryMatched = matched;
        if (matched) patternDiscoveryNodeIds.add(String(node.id));
      });

      patternDiscoveryInfo.mode = 'group-free';
    } else {
      data.nodes.forEach(node => {
        const metrics = metricsById.get(String(node.id));
        const finalScore = Number.isFinite(metrics.final_trend_score_dynamic) ? metrics.final_trend_score_dynamic : 0;
        const evidence = Number.isFinite(metrics.global_evidence_dynamic) ? metrics.global_evidence_dynamic : 0;
        const matched =
          finalScore >= settings.finalTrendMin &&
          evidence >= settings.stageEvidenceMin;

        node._patternDiscoveryMatched = matched;
        if (matched) patternDiscoveryNodeIds.add(String(node.id));
      });

      patternDiscoveryInfo.mode = 'group-aware';
    }

    const keptEdgeRows = [];
    const incidentEdgeRows = [];
    (data.edges || []).forEach(edge => {
      const s = endpointId(edge.source);
      const t = endpointId(edge.target);
      const edgeKey = patternEdgeKey(edge);
      const sourceKept = patternDiscoveryNodeIds.has(s);
      const targetKept = patternDiscoveryNodeIds.has(t);
      const matched = sourceKept && targetKept;
      edge._patternDiscoveryMatched = matched;
      edge._patternDiscoveryEdgeKey = edgeKey;
      if (matched) {
        patternDiscoveryEdgeIds.add(edgeKey);
        keptEdgeRows.push({
          edge_id: edge.id ?? edgeKey,
          source: s,
          target: t,
          weight: getCurrentEdgeWeight(edge),
          interact_id: edge.interact_id ?? edge.interact ?? null
        });
      } else if (sourceKept || targetKept) {
        incidentEdgeRows.push({
          edge_id: edge.id ?? edgeKey,
          source: s,
          target: t,
          source_kept: sourceKept,
          target_kept: targetKept,
          weight: getCurrentEdgeWeight(edge),
          interact_id: edge.interact_id ?? edge.interact ?? null
        });
      }
    });

    patternDiscoveryInfo.matchedNodes = patternDiscoveryNodeIds.size;
    patternDiscoveryInfo.matchedEdges = patternDiscoveryEdgeIds.size;

    const debugRows = (data.nodes || []).map(node => {
      const m = node._patternDiscoveryMetrics || {};
      return {
        id: String(node.id),
        gene: node.gene ?? String(node.id),
        kept: !!node._patternDiscoveryMatched,
        mode: hasStage ? 'group-aware' : 'group-free',
        global_pattern_rate: Number.isFinite(m.global_pattern_rate_dynamic) ? +m.global_pattern_rate_dynamic.toFixed(4) : null,
        global_anti_score: Number.isFinite(m.global_anti_score_dynamic) ? +m.global_anti_score_dynamic.toFixed(4) : null,
        norm_global_anti_score: Number.isFinite(m.norm_global_anti_score_dynamic) ? +m.norm_global_anti_score_dynamic.toFixed(4) : null,
        global_evidence: Number.isFinite(m.global_evidence_dynamic) ? +m.global_evidence_dynamic.toFixed(4) : null,
        final_trend_score: Number.isFinite(m.final_trend_score_dynamic) ? +m.final_trend_score_dynamic.toFixed(4) : null,
        pattern_trend: Number.isFinite(m.pattern_trend_dynamic) ? +m.pattern_trend_dynamic.toFixed(4) : null,
        exp_mty_anti_trend: Number.isFinite(m.expression_methylation_anti_trend_dynamic) ? +m.expression_methylation_anti_trend_dynamic.toFixed(4) : null,
      };
    });

    const keptRows = debugRows.filter(d => d.kept);
    const discardedRows = debugRows.filter(d => !d.kept);
    const evidenceVals = debugRows.map(d => d.global_evidence).filter(Number.isFinite);
    const finalVals = debugRows.map(d => d.final_trend_score).filter(Number.isFinite);
    const rateVals = debugRows.map(d => d.global_pattern_rate).filter(Number.isFinite);

    const scoreRanges = {
      global_pattern_rate_min: rateVals.length ? d3.min(rateVals) : null,
      global_pattern_rate_max: rateVals.length ? d3.max(rateVals) : null,
      global_evidence_min: evidenceVals.length ? d3.min(evidenceVals) : null,
      global_evidence_max: evidenceVals.length ? d3.max(evidenceVals) : null,
      final_trend_score_min: finalVals.length ? d3.min(finalVals) : null,
      final_trend_score_max: finalVals.length ? d3.max(finalVals) : null,
    };

    // Show score ranges next to the threshold controls. These are calculated after
    // all nodes are rescored under the current Pattern Discovery thresholds, so the
    // user can see whether a cutoff is too strict or too loose.
    function fmtScoreRange(minVal, maxVal, label) {
      if (!Number.isFinite(minVal) || !Number.isFinite(maxVal)) return `[${label} range: NA]`;
      return `[${label} range: ${(+minVal).toFixed(3)} – ${(+maxVal).toFixed(3)}]`;
    }

    d3.select('#patternFinalTrendRange').text(fmtScoreRange(scoreRanges.final_trend_score_min, scoreRanges.final_trend_score_max, 'TrendScore'));
    d3.select('#patternStageEvidenceRange').text(fmtScoreRange(scoreRanges.global_evidence_min, scoreRanges.global_evidence_max, 'GroupScore'));
    d3.select('#patternGlobalRateRange').text(fmtScoreRange(scoreRanges.global_pattern_rate_min, scoreRanges.global_pattern_rate_max, 'GlobalPatternRate'));
    d3.select('#patternFreeEvidenceRange').text(fmtScoreRange(scoreRanges.global_evidence_min, scoreRanges.global_evidence_max, 'GroupScore'));

    const scaleLabel = `threshold=${patternScaleLabel(settings.scale)}; intensity=JSON z-score`;
    const scoreText = hasStage
      ? `Pattern Discovery (${scaleLabel}, group-aware): ${patternDiscoveryInfo.matchedNodes}/${patternDiscoveryInfo.totalNodes} nodes, ${patternDiscoveryInfo.matchedEdges} edges`
      : `Pattern Discovery (${scaleLabel}, group-free): ${patternDiscoveryInfo.matchedNodes}/${patternDiscoveryInfo.totalNodes} nodes, ${patternDiscoveryInfo.matchedEdges} edges`;
    d3.select('#patternDiscoveryStatus').text(scoreText);
  }

  function updateAutoNodeFilterStatus(totalNodes, keptNodes, keptEdges, selectedSampleCount = 0) {
    const el = d3.select('#autoNodeFilterStatus');
    if (el.empty()) return;
    if (!useDifferenceDisplay) {
      el.text('');
      return;
    }
    el.text(`difference displaying selected ${selectedSampleCount} samples; nodes are not threshold-filtered (${keptNodes}/${totalNodes} nodes, ${keptEdges} edges shown)`);
  }

  function updateSimilarityDisplayStatus(indices, nodes) {
    const el = d3.select('#similarityDisplayStatus');
    if (el.empty()) return;

    if (!useSimilarityDisplay) {
      el.text('');
      return;
    }

    if (!Array.isArray(indices) || !indices.length) {
      el.text('no similar samples selected');
      return;
    }

    const counts = new Map();
    const arrNodes = Array.isArray(nodes) ? nodes : [];

    indices.forEach(sampleIndex => {
      const stageVotes = [];
      arrNodes.forEach(node => {
        const stageArr = Array.isArray(node?.stage_idx) ? node.stage_idx : [];
        const v = toNum(stageArr[sampleIndex]);
        if (Number.isFinite(v)) stageVotes.push(Math.floor(v));
      });

      const stage = (() => {
        const voteMap = new Map();
        stageVotes.forEach(v => voteMap.set(v, (voteMap.get(v) || 0) + 1));
        let best = null;
        let bestCount = -1;
        voteMap.forEach((count, key) => {
          if (count > bestCount || (count === bestCount && (best == null || key < best))) {
            best = key;
            bestCount = count;
          }
        });
        return best;
      })();

      if (stage != null) counts.set(stage, (counts.get(stage) || 0) + 1);
    });

    const summary = Array.from(counts.entries())
      .sort((a, b) => d3.ascending(a[0], b[0]))
      .map(([stage, count]) => `stage ${stage}: ${count}`)
      .join(', ');

    el.text(`selected ${indices.length} most-similar samples (${summary})`);
  }

  function thresholdControlIds(type, mode = null) {
    const activeMode = mode || (useSimilarityDisplay ? 'similarity' : 'difference');
    const cap = type === 'exp' ? 'Exp' : type === 'mty' ? 'Mty' : String(type).charAt(0).toUpperCase() + String(type).slice(1);
    if (activeMode === 'similarity') {
      return {
        slider: `#sim${cap}ThresholdSlider`,
        input: `#sim${cap}ThresholdValue`,
      };
    }
    return {
      slider: `#${type}ThresholdSlider`,
      input: `#${type}ThresholdValue`,
    };
  }

  function getActiveNodeThreshold(type) {
    const ids = thresholdControlIds(type);
    const value = +d3.select(ids.input).property('value');
    return Math.max(0, Number.isFinite(value) ? value : 0);
  }

  function setThresholdControlRange(type, minVal, maxVal, preferredValue = null, mode = null) {
    const ids = thresholdControlIds(type, mode);
    const slider = d3.select(ids.slider);
    const input = d3.select(ids.input);
    if (slider.empty() || input.empty()) return;

    let min = Number.isFinite(minVal) ? minVal : 0;
    let max = Number.isFinite(maxVal) ? maxVal : 5;
    if (min === max) {
      const pad = Math.max(0.1, Math.abs(min) * 0.05 || 0.1);
      min -= pad;
      max += pad;
    }
    min = Math.max(0, min);
    max = Math.max(min + 0.1, max);

    const current = Number(input.property('value'));
    let value = Number.isFinite(preferredValue) ? preferredValue : current;
    if (!Number.isFinite(value)) value = min + 0.5 * (max - min);
    value = Math.min(max, Math.max(min, value));

    const activeMode = mode || (useSimilarityDisplay ? 'similarity' : 'difference');
    autoNodeThresholdRanges[`${activeMode}:${type}`] = { min, max };

    slider.attr('min', min.toFixed(3)).attr('max', max.toFixed(3))
      .property('min', min.toFixed(3)).property('max', max.toFixed(3)).property('value', value.toFixed(3));
    input.attr('min', min.toFixed(3)).attr('max', max.toFixed(3))
      .property('min', min.toFixed(3)).property('max', max.toFixed(3)).property('value', value.toFixed(3));
  }

  function updateThresholdRangesFromScoredNodes(scoredNodes) {
    const expRanges = scoredNodes.map(n => n._autoExpRange).filter(Number.isFinite);
    const mtyRanges = scoredNodes.map(n => n._autoMtyRange).filter(Number.isFinite);
    if (!expRanges.length || !mtyRanges.length) return;

    const activeMode = useSimilarityDisplay ? 'similarity' : 'difference';
    const expIds = thresholdControlIds('exp', activeMode);
    const mtyIds = thresholdControlIds('mty', activeMode);
    const expCurrent = +d3.select(expIds.input).property('value');
    const mtyCurrent = +d3.select(mtyIds.input).property('value');

    setThresholdControlRange('exp', d3.min(expRanges), d3.max(expRanges), expCurrent, activeMode);
    setThresholdControlRange('mty', d3.min(mtyRanges), d3.max(mtyRanges), mtyCurrent, activeMode);
  }

  function applyAutoNodeFilterByDisplayedSamples(data, sampleIndices) {
    const selectedCount = Array.isArray(sampleIndices) ? sampleIndices.length : 0;
    autoNodeFilterInfo = [];
    updateAutoNodeFilterStatus(data.nodes?.length || 0, data.nodes?.length || 0, data.edges?.length || 0, selectedCount);
    return data;
  }

function setEdgeRangeInputs(edges) {
    const edgeMetric = d3.select('#edgeMetric').property('value');

    // Directed graph Min-Max normalization is recalculated as:
    //   w_norm = (w_raw - wMin) / (wMax - wMin)
    // Therefore the normalized edge range is [0, 1].
    if (edgeMetric === 'w_norm') {
      d3.select('#eRangeMin').property('value', (0).toFixed(EDGE_DECIMALS));
      d3.select('#eRangeMax').property('value', (1).toFixed(EDGE_DECIMALS));
      return;
    }

    const vals = edges.map(getCurrentEdgeWeight).filter(Number.isFinite);
    if (!vals.length) return;

    let emin = d3.min(vals);
    let emax = d3.max(vals);
    if (emin === emax) {
      const pad = Math.max(1e-8, Math.abs(emin) * 0.01 || 0.01);
      emin -= pad;
      emax += pad;
    }

    const safeMin = Math.floor(emin * EDGE_SCALE) / EDGE_SCALE;
    const safeMax = Math.ceil(emax * EDGE_SCALE) / EDGE_SCALE;
    d3.select('#eRangeMin').property('value', safeMin.toFixed(EDGE_DECIMALS));
    d3.select('#eRangeMax').property('value', safeMax.toFixed(EDGE_DECIMALS));
  }

  function getEdgeRangeInput() {
    let eMin = +d3.select('#eRangeMin').property('value');
    let eMax = +d3.select('#eRangeMax').property('value');
    if (!Number.isFinite(eMin)) eMin = -Infinity;
    if (!Number.isFinite(eMax)) eMax = Infinity;
    if (eMin > eMax) [eMin, eMax] = [eMax, eMin];
    return [eMin, eMax];
  }

  function edgePassesRange(edge) {
    if (!edgeFilterApplied) return true;
    const w = getCurrentEdgeWeight(edge);
    if (!Number.isFinite(w)) return false;
    const [eMin, eMax] = getEdgeRangeInput();
    return w >= eMin - EDGE_EPS && w <= eMax + EDGE_EPS;
  }


  function getCurrentVisibleGraph(data) {
    if (!data) return { nodes: [], edges: [] };

    // 1) Apply the current HTML edge rules first.
    //    This includes the selected edge metric and the current edge range after clicking "Filter edges".
    const edgeCandidates = (data.edges || []).filter(edgePassesRange);

    // 2) Recompute degree from the edges that are actually visible in HTML.
    //    This is intentionally different from node.degree exported by R.
    const visibleDegree = new Map();
    (data.nodes || []).forEach(node => {
      visibleDegree.set(String(node.id), 0);
    });

    edgeCandidates.forEach(edge => {
      const s = String(edge.source);
      const t = String(edge.target);
      if (!visibleDegree.has(s)) visibleDegree.set(s, 0);
      if (!visibleDegree.has(t)) visibleDegree.set(t, 0);

      if (s === t) {
        visibleDegree.set(s, (visibleDegree.get(s) || 0) + 2);
      } else {
        visibleDegree.set(s, (visibleDegree.get(s) || 0) + 1);
        visibleDegree.set(t, (visibleDegree.get(t) || 0) + 1);
      }
    });

    // 3) Use the HTML-visible degree for the Degree Range control.
    const dMinInput = +d3.select('#degMin').property('value');
    const dMaxInput = +d3.select('#degMax').property('value');
    let dmin = Number.isFinite(dMinInput) ? dMinInput : 0;
    let dmax = Number.isFinite(dMaxInput) ? dMaxInput : Infinity;
    if (dmin > dmax) [dmin, dmax] = [dmax, dmin];

    const visibleNodes = (data.nodes || []).filter(node => {
      const d = visibleDegree.get(String(node.id)) || 0;
      node.visibleDegree = d;
      return d >= dmin && d <= dmax;
    });

    const visibleNodeIds = new Set(visibleNodes.map(node => String(node.id)));

    // 4) Keep only edges whose endpoints still exist after visible-degree filtering.
    const visibleEdges = edgeCandidates.filter(edge =>
      visibleNodeIds.has(String(edge.source)) && visibleNodeIds.has(String(edge.target))
    );

    return { nodes: visibleNodes, edges: visibleEdges };
  }

  function renderStageLegend() {
    const container = d3.select('#stageLegend');
    if (container.empty()) return;
    container.selectAll('*').remove();

    const wrap = container.append('div')
      .style('display', 'inline-flex')
      .style('gap', '14px')
      .style('align-items', 'center')
      .style('flex-wrap', 'wrap');

    const hasRealGroup = hasUsableStageData(currentData);
    if (!hasRealGroup) {
      wrap.append('span')
        .text('no group/stage data')
        .style('color', '#888')
        .style('font-size', '13px');
      return;
    }

    const present = new Set();
    if (currentData?.nodes?.length) {
      currentData.nodes.forEach(n => {
        const arr0 = Array.isArray(n.stage_idx) ? n.stage_idx : [];
        const arr = getDisplayValues(n, arr0);
        arr.forEach(v => {
          const x = Math.floor(+v);
          if (Number.isFinite(x) && x >= 0) present.add(x % STAGE_IDS.length);
        });
      });
    }

    STAGE_IDS.forEach(i => {
      const hasData = present.has(i);
      const color = stageColorMap.get(i) || DEFAULT_STAGE_COLORS[i];

      const row = wrap.append('label')
        .style('display', 'inline-flex')
        .style('align-items', 'center')
        .style('gap', '8px');

      row.append('span').text(`group ${i}`).style('opacity', hasData ? 1 : 0.45);

      row.append('input')
        .attr('type', 'color')
        .attr('id', `stageColor-${i}`)
        .attr('value', color)
        .property('value', color)
        .property('disabled', !hasData)
        .style('width', '28px')
        .style('height', '28px')
        .style('padding', '0')
        .style('border', '1px solid #ccc')
        .style('cursor', hasData ? 'pointer' : 'not-allowed')
        .style('filter', hasData ? null : 'grayscale(100%) brightness(0.85)')
        .style('opacity', hasData ? 1 : 0.7)
        .on('input', function () {
          if (!hasData) return;
          setStageColor(i, this.value);
          updateStyles();
        })
        .on('change', function () {
          if (!hasData) return;
          setStageColor(i, this.value);
          updateStyles();
        });
    });
  }

  function getLayoutMode() {
    const el = document.getElementById('layoutSelect');
    return el ? el.value : currentLayoutMode || 'loose-balanced';
  }

  function getCanvasSizeForLayout() {
    const box = document.getElementById('networkViz').getBoundingClientRect();
    return {
      width: Math.max(box.width || window.innerWidth, 800),
      height: Math.max(box.height || (window.innerHeight - 185), 600),
    };
  }

  function getConnectedComponents(nodes, edges) {
    const ids = nodes.map(n => String(n.id));
    const idSet = new Set(ids);
    const adj = new Map(ids.map(id => [id, []]));

    edges.forEach(e => {
      const s = String(e.source);
      const t = String(e.target);
      if (!idSet.has(s) || !idSet.has(t)) return;
      adj.get(s).push(t);
      adj.get(t).push(s);
    });

    const seen = new Set();
    const comps = [];

    ids.forEach(start => {
      if (seen.has(start)) return;
      const stack = [start];
      const comp = [];
      seen.add(start);

      while (stack.length) {
        const v = stack.pop();
        comp.push(v);
        (adj.get(v) || []).forEach(nb => {
          if (!seen.has(nb)) {
            seen.add(nb);
            stack.push(nb);
          }
        });
      }
      comps.push(comp);
    });

    comps.sort((a, b) => b.length - a.length);
    return comps;
  }

  function relaxNodeCollisions(nodes, radius = NODE_SIZE * 0.78, iterations = 80) {
    if (!Array.isArray(nodes) || nodes.length < 2) return;

    for (let k = 0; k < iterations; k++) {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          let dx = b.x - a.x;
          let dy = b.y - a.y;
          let dist = Math.hypot(dx, dy);

          if (!Number.isFinite(dist) || dist === 0) {
            dx = (Math.random() - 0.5) * 2;
            dy = (Math.random() - 0.5) * 2;
            dist = Math.hypot(dx, dy) || 1;
          }

          const minDist = radius * 2;
          if (dist < minDist) {
            const push = (minDist - dist) / 2;
            const nx = dx / dist;
            const ny = dy / dist;
            a.x -= nx * push;
            a.y -= ny * push;
            b.x += nx * push;
            b.y += ny * push;
          }
        }
      }
    }
  }

  function layoutGrid(nodes, width, height, spacing = NODE_SIZE * 1.65) {
    const n = nodes.length;
    if (!n) return;
    const cols = Math.ceil(Math.sqrt(n * width / height));
    const rows = Math.ceil(n / cols);
    const totalW = (cols - 1) * spacing;
    const totalH = (rows - 1) * spacing;
    const startX = width / 2 - totalW / 2;
    const startY = height / 2 - totalH / 2;

    nodes.forEach((node, i) => {
      const col = i % cols;
      const row = Math.floor(i / cols);
      node.x = startX + col * spacing;
      node.y = startY + row * spacing;
    });
  }

  function layoutCircle(nodes, width, height, radiusMultiplier = 1.0) {
    const n = nodes.length;
    if (!n) return;
    const minR = Math.max(NODE_SIZE * 1.35, n * NODE_SIZE * 0.34);
    const maxR = Math.min(width, height) * 0.42;
    const r = Math.max(minR, maxR * radiusMultiplier);

    nodes.forEach((node, i) => {
      const angle = -Math.PI / 2 + i * 2 * Math.PI / n;
      node.x = width / 2 + r * Math.cos(angle);
      node.y = height / 2 + r * Math.sin(angle);
    });
  }

  function layoutConcentric(nodes, edges, width, height) {
    const degreeMap = new Map(nodes.map(n => [String(n.id), 0]));
    edges.forEach(e => {
      const s = String(e.source);
      const t = String(e.target);
      if (degreeMap.has(s)) degreeMap.set(s, degreeMap.get(s) + 1);
      if (degreeMap.has(t)) degreeMap.set(t, degreeMap.get(t) + 1);
    });

    const sorted = nodes.slice().sort((a, b) =>
      d3.descending(degreeMap.get(String(a.id)) || 0, degreeMap.get(String(b.id)) || 0) ||
      d3.ascending(String(a.id), String(b.id))
    );

    const basePerRing = Math.max(6, Math.ceil(Math.sqrt(nodes.length) * 1.8));
    const ringGap = NODE_SIZE * 1.55;

    sorted.forEach((node, i) => {
      if (i === 0) {
        node.x = width / 2;
        node.y = height / 2;
        return;
      }

      const ring = Math.ceil(i / basePerRing);
      const ringStart = (ring - 1) * basePerRing + 1;
      const indexInRing = i - ringStart;
      const countInRing = Math.min(basePerRing * ring, nodes.length - ringStart);
      const r = ring * ringGap;
      const angle = -Math.PI / 2 + indexInRing * 2 * Math.PI / Math.max(countInRing, 1);
      node.x = width / 2 + r * Math.cos(angle);
      node.y = height / 2 + r * Math.sin(angle);
    });
  }

  function layoutComponentGrid(nodes, edges, width, height) {
    const nodeMap = new Map(nodes.map(n => [String(n.id), n]));
    const comps = getConnectedComponents(nodes, edges);
    const compCount = comps.length;
    const cols = Math.ceil(Math.sqrt(compCount * width / height));
    const rows = Math.ceil(compCount / cols);
    const cellW = width / Math.max(cols, 1);
    const cellH = height / Math.max(rows, 1);

    comps.forEach((ids, ci) => {
      const col = ci % cols;
      const row = Math.floor(ci / cols);
      const cx = cellW * col + cellW / 2;
      const cy = cellH * row + cellH / 2;
      const compNodes = ids.map(id => nodeMap.get(id)).filter(Boolean);
      const n = compNodes.length;

      if (n === 1) {
        compNodes[0].x = cx;
        compNodes[0].y = cy;
        return;
      }

      const localR = Math.max(NODE_SIZE * 1.2, Math.min(cellW, cellH) * 0.28, n * NODE_SIZE * 0.18);
      compNodes.forEach((node, i) => {
        const angle = -Math.PI / 2 + i * 2 * Math.PI / n;
        node.x = cx + localR * Math.cos(angle);
        node.y = cy + localR * Math.sin(angle);
      });
    });
  }

  function layoutForce(nodes, edges, width, height, mode) {
    const edgesForLayout = edges.map(e => ({
      ...e,
      source: getId(e.source),
      target: getId(e.target),
    }));

    let linkDistance = 155;
    let chargeStrength = -420;
    let collisionRadius = NODE_SIZE * 0.92;
    let centerStrength = 0.055;
    let radialStrength = 0.012;
    let ticks = 140;

    if (mode === 'soft-spread') {
      linkDistance = 175;
      chargeStrength = -520;
      collisionRadius = NODE_SIZE * 1.0;
      centerStrength = 0.035;
      radialStrength = 0.008;
      ticks = 420;
    }

    if (mode === 'spread-force') {
      linkDistance = 210;
      chargeStrength = -760;
      collisionRadius = NODE_SIZE * 1.12;
      centerStrength = 0.025;
      radialStrength = 0.004;
      ticks = 520;
    }

    nodes.forEach((n, i) => {
      if (!Number.isFinite(n.x) || !Number.isFinite(n.y)) {
        const angle = i * 2 * Math.PI / Math.max(nodes.length, 1);
        const r = 120 + NODE_SIZE * 0.45 * Math.sqrt(i);
        n.x = width / 2 + r * Math.cos(angle);
        n.y = height / 2 + r * Math.sin(angle);
      }
    });

    const sim = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(edgesForLayout)
        .id(d => getId(d.id))
        .distance(linkDistance)
        .strength(0.45)
      )
      .force('charge', d3.forceManyBody()
        .strength(chargeStrength)
        .distanceMin(NODE_SIZE * 0.8)
        .distanceMax(Math.max(width, height) * 1.2)
      )
      .force('center', d3.forceCenter(width / 2, height / 2).strength(centerStrength))
      .force('x', d3.forceX(width / 2).strength(centerStrength * 0.35))
      .force('y', d3.forceY(height / 2).strength(centerStrength * 0.35))
      .force('radial', d3.forceRadial(Math.min(width, height) * 0.33, width / 2, height / 2).strength(radialStrength))
      .force('collision', d3.forceCollide().radius(collisionRadius).strength(1).iterations(5))
      .alpha(1)
      .alphaDecay(0.025)
      .velocityDecay(0.72)
      .alphaMin(0.001);

    for (let i = 0; i < ticks; ++i) sim.tick();
    sim.stop();
    relaxNodeCollisions(nodes, collisionRadius, 100);
  }

  function computeLayoutOnce(data, { preserveExisting = false } = {}) {
    const { width, height } = getCanvasSizeForLayout();
    const mode = getLayoutMode();
    currentLayoutMode = mode;

    const nodes = data.nodes || [];
    const edges = (data.edges || []).map(e => ({
      ...e,
      source: getId(e.source),
      target: getId(e.target),
    }));

    if (!nodes.length) return;

    nodes.forEach((n, i) => {
      n.id = getId(n.id);

      // When preserveExisting is true, keep positions already created by user drag
      // or previous filter states. Missing/new nodes still get a deterministic seed.
      if (preserveExisting && Number.isFinite(+n.x) && Number.isFinite(+n.y)) return;

      const angle = i * 2 * Math.PI / Math.max(nodes.length, 1);
      const r = 120 + NODE_SIZE * 0.45 * Math.sqrt(i);
      n.x = getCanvasSizeForLayout().width / 2 + r * Math.cos(angle);
      n.y = getCanvasSizeForLayout().height / 2 + r * Math.sin(angle);
    });

    if (mode === 'grid') {
      layoutGrid(nodes, width, height, NODE_SIZE * 1.65);
      relaxNodeCollisions(nodes, NODE_SIZE * 0.82, 60);
      return;
    }

    if (mode === 'circle') {
      layoutCircle(nodes, width, height, 1.0);
      relaxNodeCollisions(nodes, NODE_SIZE * 0.82, 60);
      return;
    }

    if (mode === 'concentric') {
      layoutConcentric(nodes, edges, width, height);
      relaxNodeCollisions(nodes, NODE_SIZE * 0.86, 80);
      return;
    }

    if (mode === 'component-grid') {
      layoutComponentGrid(nodes, edges, width, height);
      relaxNodeCollisions(nodes, NODE_SIZE * 0.86, 80);
      return;
    }

    layoutForce(nodes, edges, width, height, mode);
  }

  function buildFilteredCommunity(raw, dmin, dmax) {
    const nodesById = new Map(raw.nodes.map(n => [getId(n.id), n]));
    const inRangeIds = new Set(raw.nodes
      .filter(n => Number(n.degree ?? 0) >= dmin && Number(n.degree ?? 0) <= dmax)
      .map(n => getId(n.id))
    );

    const highNeighborIds = new Set();
    raw.edges.forEach(e => {
      const sId = getId(e.source);
      const tId = getId(e.target);
      const sNode = nodesById.get(sId);
      const tNode = nodesById.get(tId);
      if (!sNode || !tNode) return;
      const sIn = inRangeIds.has(sId);
      const tIn = inRangeIds.has(tId);
      if (sIn && Number(tNode.degree ?? 0) > dmax) highNeighborIds.add(tId);
      if (tIn && Number(sNode.degree ?? 0) > dmax) highNeighborIds.add(sId);
    });

    const usedIdSet = new Set([...inRangeIds, ...highNeighborIds]);

    const nodesUsed = raw.nodes
      .filter(n => usedIdSet.has(getId(n.id)))
      .map(n => ({ ...n, id: getId(n.id) }));

    const edgesUsed = raw.edges
      .filter(e => {
        const sId = getId(e.source);
        const tId = getId(e.target);
        return usedIdSet.has(sId) && usedIdSet.has(tId);
      })
      .map((e, idx) => ({
        ...e,
        id: e.id ? String(e.id) : `e-${getId(e.source)}-${getId(e.target)}-${idx}`,
        source: getId(e.source),
        target: getId(e.target),
      }));

    return {
      ...raw,
      nodes: nodesUsed,
      edges: edgesUsed,
    };
  }

  function sanitizeForG6(data) {
    const nodes = (data.nodes || []).map(n => ({ ...n, id: endpointId(n.id) }));
    const nodeIdSet = new Set(nodes.map(n => n.id));
    const edges = (data.edges || []).map((e, idx) => {
      const source = endpointId(e.source);
      const target = endpointId(e.target);
      const id = e.id ? String(e.id) : `e-${source}-${target}-${idx}`;
      const valid = source && target && nodeIdSet.has(source) && nodeIdSet.has(target);
      if (!valid) return null;
      return { ...e, id, source, target };
    }).filter(Boolean);
    return { ...data, nodes, edges };
  }

  function getNearestPortIndexByAngle(angle) {
    let bestIndex = 0;
    let bestDist = Infinity;

    NODE_PORTS_META.forEach((p, i) => {
      const d = angleDistance(angle, p.angle);
      if (d < bestDist) {
        bestDist = d;
        bestIndex = i;
      }
    });

    return bestIndex;
  }

  function getShiftedPortKeyByAngle(angle, stepShift = 0) {
    const n = NODE_PORTS_META.length;
    const baseIndex = getNearestPortIndexByAngle(angle);
    const index = ((baseIndex + stepShift) % n + n) % n;
    return NODE_PORTS_META[index]?.key || NODE_PORTS_META[0].key;
  }

  function buildPortSpreadShifts(count, baseStep = PARALLEL_PORT_STEP, allowZeroForSingle = true) {
    if (count <= 0) return [];
    if (count === 1 && allowZeroForSingle) return [0];

    const out = [];
    let level = 1;
    while (out.length < count) {
      out.push(level * baseStep);
      if (out.length < count) out.push(-level * baseStep);
      level += 1;
    }
    return out.slice(0, count);
  }

  function assignEdgePorts(nodes, edges) {
    const nodeMap = new Map(nodes.map(n => [String(n.id), n]));
    const pairMap = new Map();

    edges.forEach(edge => {
      const s = String(edge.source);
      const t = String(edge.target);
      const key = s <= t ? `${s}|${t}` : `${t}|${s}`;
      if (!pairMap.has(key)) pairMap.set(key, []);
      pairMap.get(key).push(edge);
    });

    function groupByType(list) {
      const groups = new Map();
      list.forEach(edge => {
        const typeName = getEdgeTypeName(edge) || '__default__';
        if (!groups.has(typeName)) groups.set(typeName, []);
        groups.get(typeName).push(edge);
      });
      return Array.from(groups.entries())
        .sort((a, b) => String(a[0]).localeCompare(String(b[0])))
        .map(([typeName, items]) => ({ typeName, items }));
    }

    function symmetricNonZeroOffsets(count, step) {
      if (count <= 0) return [];
      if (count === 1) return [step];
      const out = [];
      let level = 1;
      while (out.length < count) {
        out.push(level * step);
        if (out.length < count) out.push(-level * step);
        level += 1;
      }
      return out.slice(0, count);
    }

    function centeredLocalOffsets(count, step) {
      if (count <= 0) return [];
      if (count === 1) return [0];
      const out = [0];
      let level = 1;
      while (out.length < count) {
        out.push(level * step);
        if (out.length < count) out.push(-level * step);
        level += 1;
      }
      return out.slice(0, count);
    }

    pairMap.forEach((list, key) => {
      const [a, b] = key.split('|');

      if (a === b) {
        const node = nodeMap.get(a);
        if (!node) {
          list.forEach(edge => {
            edge._sourcePort = 'p0';
            edge._targetPort = 'p36';
          });
          return;
        }

        const loopGroups = groupByType(list);
        const sideOrder = [0, 1, 3, 2];
        const placements = [
          { sourceAngle: -2.45, targetAngle: -0.70 },
          { sourceAngle: -0.65, targetAngle:  0.65 },
          { sourceAngle:  0.70, targetAngle:  2.45 },
          { sourceAngle:  2.50, targetAngle:  3.78 }
        ];

        loopGroups.forEach((group, gi) => {
          const sideIndex = sideOrder[gi % sideOrder.length];
          const ringLevel = Math.floor(gi / sideOrder.length);
          const placement = placements[sideIndex];
          const localOffsets = centeredLocalOffsets(group.items.length, 1.8);
          group.items.forEach((edge, i) => {
            edge._selfLoopSide = sideIndex;
            edge._selfLoopLevel = ringLevel * 2 + Math.floor(i / 2);
            const local = localOffsets[i] || 0;
            const sideSpread = 1.8 + ringLevel * 2.2 + Math.abs(local);
            const sourceShift = Math.sign(-sideSpread - local || -1) * Math.max(1, Math.round(Math.abs(-sideSpread - local) * (ARROW_SOURCE_PORT_MULTIPLIER + 0.10)));
            const targetShift = Math.sign(sideSpread - local || 1) * Math.max(1, Math.round(Math.abs(sideSpread - local) * (ARROW_TARGET_PORT_MULTIPLIER + 0.30)));
            edge._sourcePort = getShiftedPortKeyByAngle(placement.sourceAngle, sourceShift);
            edge._targetPort = getShiftedPortKeyByAngle(placement.targetAngle, targetShift);
          });
        });
        return;
      }

      const nodeA = nodeMap.get(a);
      const nodeB = nodeMap.get(b);
      if (!nodeA || !nodeB) {
        list.forEach(edge => {
          edge._sourcePort = 'p0';
          edge._targetPort = 'p36';
        });
        return;
      }

      const dx = nodeB.x - nodeA.x;
      const dy = nodeB.y - nodeA.y;
      const baseAngleAB = Math.atan2(dy, dx);
      const baseAngleBA = Math.atan2(-dy, -dx);

      const ab = list.filter(edge => String(edge.source) === a && String(edge.target) === b);
      const ba = list.filter(edge => String(edge.source) === b && String(edge.target) === a);
      const abGroups = groupByType(ab);
      const baGroups = groupByType(ba);
      const hasBothDirections = ab.length > 0 && ba.length > 0;

      function applyDirectedGroups(groups, sourceAngle, targetAngle, directionTag) {
        if (!groups.length) return;

        // IMPORTANT:
        // When both directions exist, both A->B and B->A use the SAME positive side index
        // relative to their own orientation. Because the path direction is reversed, this places
        // the two directions on opposite GLOBAL sides instead of collapsing onto one side.
        const baseOffsets = hasBothDirections
          ? groups.map((_, i) => OPPOSITE_EDGE_GAP + i * (PARALLEL_EDGE_STEP + 10))
          : symmetricNonZeroOffsets(groups.length, PARALLEL_EDGE_STEP);

        groups.forEach((group, gi) => {
          const base = baseOffsets[gi] || 0;
          const localOffsets = centeredLocalOffsets(group.items.length, PARALLEL_EDGE_STEP * 0.72);
          group.items.forEach((edge, i) => {
            const local = localOffsets[i] || 0;
            const totalOffset = hasBothDirections ? base + Math.abs(local) : base + local;
            const portShiftMag = hasBothDirections
              ? 2 + Math.floor(Math.abs(totalOffset) / Math.max(1, PARALLEL_EDGE_STEP * 0.82))
              : 1 + Math.floor(Math.abs(totalOffset) / Math.max(1, PARALLEL_EDGE_STEP * 0.92));
            const portShift = hasBothDirections ? portShiftMag : ((Math.sign(totalOffset) || 1) * portShiftMag);
            const sourceShift = Math.sign(portShift || 1) * Math.max(1, Math.round(Math.abs(portShift) * ARROW_SOURCE_PORT_MULTIPLIER));
            const targetShift = Math.sign(portShift || 1) * Math.max(1, Math.round(Math.abs(portShift) * ARROW_TARGET_PORT_MULTIPLIER));
            edge._sourcePort = getShiftedPortKeyByAngle(sourceAngle, sourceShift);
            edge._targetPort = getShiftedPortKeyByAngle(targetAngle, targetShift);
            edge._groupBaseOffset = base;
            edge._groupLocalOffset = local;
            edge._preferredCurveOffset = totalOffset;
            edge._directionTag = directionTag;
            edge._hasBothDirections = hasBothDirections;
          });
        });
      }

      applyDirectedGroups(abGroups, baseAngleAB, baseAngleBA, 'forward');
      applyDirectedGroups(baGroups, baseAngleBA, baseAngleAB, 'reverse');
    });
  }

  function annotateEdgeGeometry(edges) {
    const pairMap = new Map();

    edges.forEach(e => {
      const s = String(e.source);
      const t = String(e.target);
      const key = s <= t ? `${s}|${t}` : `${t}|${s}`;
      if (!pairMap.has(key)) pairMap.set(key, []);
      pairMap.get(key).push(e);
    });

    function markStraight(e) {
      e._edgeType = 'line';
      e._curvePosition = 0.5;
      e._curveOffset = 0;
    }

    function markCurved(e, offset) {
      e._edgeType = 'quadratic';
      e._curvePosition = 0.5;
      e._curveOffset = offset;
    }

    function groupByType(list) {
      const groups = new Map();
      list.forEach(edge => {
        const typeName = getEdgeTypeName(edge) || '__default__';
        if (!groups.has(typeName)) groups.set(typeName, []);
        groups.get(typeName).push(edge);
      });
      return Array.from(groups.entries())
        .sort((a, b) => String(a[0]).localeCompare(String(b[0])))
        .map(([typeName, items]) => ({ typeName, items }));
    }

    function symmetricNonZeroOffsets(count, step) {
      if (count <= 0) return [];
      if (count === 1) return [step];
      const out = [];
      let level = 1;
      while (out.length < count) {
        out.push(level * step);
        if (out.length < count) out.push(-level * step);
        level += 1;
      }
      return out.slice(0, count);
    }

    function centeredLocalOffsets(count, step) {
      if (count <= 0) return [];
      if (count === 1) return [0];
      const out = [0];
      let level = 1;
      while (out.length < count) {
        out.push(level * step);
        if (out.length < count) out.push(-level * step);
        level += 1;
      }
      return out.slice(0, count);
    }

    pairMap.forEach((list, key) => {
      const [a, b] = key.split('|');

      if (a === b) {
        const loopGroups = groupByType(list);
        loopGroups.forEach((group, gi) => {
          group.items.forEach((e, i) => {
            const sideIndex = e._selfLoopSide ?? (gi % 4);
            const level = e._selfLoopLevel ?? Math.floor(gi / 4) + Math.floor(i / 2);
            const sideBase = [18, 20, 20, 18][sideIndex] || 18;
            const local = (i % 2 === 0 ? -1 : 1) * 3;
            const magnitude = sideBase + level * SELF_LOOP_STEP + Math.abs(local);
            markCurved(e, -magnitude);
            e._curvePosition = 0.5;
          });
        });
        return;
      }

      const ab = list.filter(e => String(e.source) === a && String(e.target) === b);
      const ba = list.filter(e => String(e.source) === b && String(e.target) === a);
      const abGroups = groupByType(ab);
      const baGroups = groupByType(ba);
      const hasBothDirections = ab.length > 0 && ba.length > 0;

      function applyDirectedGroups(groups, directionTag) {
        if (!groups.length) return;

        const baseOffsets = hasBothDirections
          ? groups.map((_, i) => OPPOSITE_EDGE_GAP + i * (PARALLEL_EDGE_STEP + 10))
          : symmetricNonZeroOffsets(groups.length, PARALLEL_EDGE_STEP);

        groups.forEach((group, gi) => {
          const base = Number.isFinite(group.items[0]?._groupBaseOffset)
            ? group.items[0]._groupBaseOffset
            : (baseOffsets[gi] || 0);
          const localOffsets = centeredLocalOffsets(group.items.length, PARALLEL_EDGE_STEP * 0.72);

          if (group.items.length === 1 && !hasBothDirections && groups.length === 1) {
            markStraight(group.items[0]);
            return;
          }

          group.items.forEach((edge, i) => {
            let offset;
            if (hasBothDirections) {
              // SAME sign for both directions relative to each edge's own orientation.
              // Because the underlying path direction is reversed, this places reverse edges
              // on the opposite GLOBAL side instead of overlapping.
              const local = Math.abs(localOffsets[i] || 0);
              offset = base + local;
            } else {
              offset = Number.isFinite(edge._preferredCurveOffset)
                ? edge._preferredCurveOffset
                : base + (localOffsets[i] || 0);
              if (Math.abs(offset) < 2) offset = Math.max(8, PARALLEL_EDGE_STEP * 0.45);
            }
            markCurved(edge, offset);
          });
        });
      }

      applyDirectedGroups(abGroups, 'forward');
      applyDirectedGroups(baGroups, 'reverse');
    });
  }

  function rebuildFocusIndex(data) {
    neighborMap = new Map();
    (data.nodes || []).forEach(n => neighborMap.set(String(n.id), new Set()));
    (data.edges || []).forEach(e => {
      const s = String(e.source);
      const t = String(e.target);
      if (!neighborMap.has(s)) neighborMap.set(s, new Set());
      if (!neighborMap.has(t)) neighborMap.set(t, new Set());
      neighborMap.get(s).add(t);
      neighborMap.get(t).add(s);
    });
  }

  function isNodeFocusedOrNeighbor(nodeId) {
    if (!focusedNodeId) return true;
    const id = String(nodeId);
    if (id === focusedNodeId) return true;
    return neighborMap.get(focusedNodeId)?.has(id) || false;
  }

  function isFocusedNode(nodeId) {
    return !!focusedNodeId && String(nodeId) === String(focusedNodeId);
  }

  function isFocusedNeighbor(nodeId) {
    return !!focusedNodeId && !isFocusedNode(nodeId) && (neighborMap.get(String(focusedNodeId))?.has(String(nodeId)) || false);
  }

  function isSearchRelatedNode(nodeId) {
    return !focusedNodeId || isFocusedNode(nodeId) || isFocusedNeighbor(nodeId);
  }

  function isEdgeFocused(edge) {
    if (!focusedNodeId) return true;
    const s = endpointId(edge.source);
    const t = endpointId(edge.target);
    return s === String(focusedNodeId) || t === String(focusedNodeId);
  }

  function strokeArc(ctx, cx, cy, inner, width, start, end, color, alpha = 1) {
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, inner + width / 2, start, end);
    ctx.strokeStyle = color;
    ctx.globalAlpha = alpha;
    ctx.lineWidth = width;
    ctx.lineCap = 'butt';
    ctx.stroke();
    ctx.restore();
  }

  function renderNodeSprite(nodeDatum) {
    const canvas = createOffscreen(SPRITE_SIZE);
    const ctx = canvas.getContext('2d');

    ctx.clearRect(0, 0, SPRITE_SIZE, SPRITE_SIZE);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';

    ctx.save();
    ctx.font = `bold ${20 * SPRITE_SCALE}px sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 4 * SPRITE_SCALE;
    ctx.strokeStyle = 'rgba(255,255,255,0.97)';
    ctx.fillStyle = '#222';
    const label = String(nodeDatum.id || '');
    const clipped = label.length > 18 ? `${label.slice(0, 16)}…` : label;
    ctx.strokeText(clipped, CX, 24 * SPRITE_SCALE);
    ctx.fillText(clipped, CX, 24 * SPRITE_SCALE);
    ctx.restore();

    const omicsTypeSelected = d3.select('#omicsType').property('value');
    const rmin = +d3.select('#rangeMin').property('value');
    const rmax = +d3.select('#rangeMax').property('value');
    const displayIndices = getDisplaySampleIndices(nodeDatum);

    const sampleCount = displayIndices
      ? Math.max(displayIndices.length, 1)
      : Math.max(
          nodeDatum.exp_vals?.length || 0,
          nodeDatum.mty_vals?.length || 0,
          nodeDatum.cnv_vals?.length || 0,
          nodeDatum.snv_vals?.length || 0,
          nodeDatum.stage_idx?.length || 0,
          1
        );

    const angleStep = 2 * Math.PI / sampleCount;

    const rings = RING_LAYOUT.map(ring => {
      if (ring.type === 'stage') {
        // Hide the group/stage ring when the R exporter says there is no real stage/group,
        // or when the only available value is a single fallback group such as all 0.
        if (!hasUsableStageData(currentData)) return null;
        const vals0 = Array.isArray(nodeDatum.stage_idx) ? nodeDatum.stage_idx : [];
        return { ...ring, vals: getDisplayValues(nodeDatum, vals0), scale: null };
      }

      const key = metricKey(ring.type);
      const vals0 = Array.isArray(nodeDatum[key]) ? nodeDatum[key] : [];
      return { ...ring, vals: getDisplayValues(nodeDatum, vals0), scale: colorConfig[ring.type] };
    }).filter(r => r && Array.isArray(r.vals));

    // Draw faint guide circles only for the inner omics rings.
    // Do not draw an outer grey guide around the stage/group ring,
    // otherwise non-search nodes appear to have an unwanted grey outer border.
    ctx.save();
    ctx.strokeStyle = '#ececec';
    ctx.lineWidth = 1.1 * SPRITE_SCALE;
    rings.forEach(r => {
      if (r.type === 'stage') return;
      ctx.beginPath();
      ctx.arc(CX, CY, r.inner + RING_W / 2, 0, 2 * Math.PI);
      ctx.stroke();
    });
    ctx.restore();

    rings.forEach(ring => {
      const isSelectedOmics = ring.type === omicsTypeSelected;
      const isStage = ring.type === 'stage';
      const vals = ring.vals.length ? ring.vals : new Array(sampleCount).fill(null);

      vals.forEach((v, i) => {
        const start = -Math.PI / 2 + i * angleStep;
        const end = -Math.PI / 2 + (i + 1) * angleStep;
        const numV = toNum(v);
        if (!Number.isFinite(numV)) return;

        let fill = 'transparent';
        let alpha = 1;

        if (isStage) {
          fill = getStageColorByIndex(numV);
          alpha = fill === 'transparent' ? 0 : 1;
        } else {
          const inRange = numV >= rmin && numV <= rmax;
          fill = (isSelectedOmics && !inRange) ? '#CCCCCC' : ring.scale(numV);
          alpha = (!isSelectedOmics) ? 1 : (inRange ? 1 : 0.28);
        }

        strokeArc(ctx, CX, CY, ring.inner, RING_W, start, end, fill, alpha);
      });
    });

    ctx.save();
    ctx.beginPath();
    ctx.arc(CX, CY, RING_W + 1.5 * SPRITE_SCALE, 0, 2 * Math.PI);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    ctx.strokeStyle = '#777';
    ctx.lineWidth = 1 * SPRITE_SCALE;
    ctx.stroke();
    ctx.restore();

    // Node-search marker: draw one clean white halo hugging the outside of the
    // stage/group ring. Keep it as a single ring only, with a soft white glow.
    if (focusedNodeId) {
      const nodeId = String(nodeDatum.id);
      const selected = nodeId === String(focusedNodeId);

      if (selected) {
        const markerWidth = 5.2 * SPRITE_SCALE;
        const markerGap = 0.95 * SPRITE_SCALE;
        const markerRadius = OUTER_RING_RADIUS + markerGap + markerWidth / 2;

        ctx.save();
        ctx.beginPath();
        ctx.arc(CX, CY, markerRadius, 0, 2 * Math.PI);
        ctx.strokeStyle = NODE_SEARCH_RING_COLOR;
        ctx.globalAlpha = 1;
        ctx.lineWidth = markerWidth;
        // Make the halo brighter and more diffused so it stands out clearly among other nodes.
        ctx.shadowColor = NODE_SEARCH_RING_GLOW_COLOR;
        ctx.shadowBlur = 9.5 * SPRITE_SCALE;
        ctx.stroke();
        ctx.restore();
      }
    }

    return canvasToDataURL(canvas);
  }

  function rebuildNodeSpritesIfNeeded() {
    if (!currentData || !spriteDirty) return;
    currentData.nodes.forEach(node => {
      node._sprite = renderNodeSprite(node);
    });
    spriteDirty = false;
  }

  function computeNodeStyleUpdates(nodes) {
    // Rebuild sprites when search focus changes so the selected node can receive
    // a real bright-white halo outside the outermost ring, not only a CSS shadow.
    rebuildNodeSpritesIfNeeded();

    const omicsType = d3.select('#omicsType').property('value');
    const key = metricKey(omicsType);
    const rmin = +d3.select('#rangeMin').property('value');
    const rmax = +d3.select('#rangeMax').property('value');

    nodes.forEach(n => {
      const vals0 = Array.isArray(n[key]) ? n[key] : [];
      const vals = getDisplayValues(n, vals0);
      n._highlight = Array.isArray(vals) && vals.some(v => {
        const x = toNum(v);
        return Number.isFinite(x) && x >= rmin && x <= rmax;
      });
    });

    const hasSearchFocus = !!focusedNodeId;
    const patternActive = !!usePatternDiscovery && patternDiscoveryNodeIds instanceof Set;

    return nodes.map(node => {
      const nodeId = String(node.id);
      const isSelected = hasSearchFocus && nodeId === String(focusedNodeId);
      const isNeighbor = hasSearchFocus && !isSelected && (neighborMap.get(String(focusedNodeId))?.has(nodeId) || false);
      const searchRelated = !hasSearchFocus || isSelected || isNeighbor;
      const inPattern = patternActive && patternDiscoveryNodeIds.has(nodeId);

      let opacity = node._highlight ? 1 : 0.35;
      let size = NODE_SIZE;
      let shadowColor = 'transparent';
      let shadowBlur = 0;
      let zIndex = 100;

      // Priority 1: Node search. This works both with and without Pattern Discovery.
      // When Pattern Discovery is active, search temporarily overlays the current
      // Pattern state; clearing search restores the Pattern highlights instead of
      // resetting the graph to the original state.
      if (hasSearchFocus) {
        if (isSelected) {
          opacity = 1;
          size = NODE_SIZE * 1.22;
          shadowColor = 'transparent';
          shadowBlur = 0;
          zIndex = 520;
        } else if (isNeighbor) {
          opacity = 1;
          size = NODE_SIZE * 1.08;
          shadowColor = 'transparent';
          shadowBlur = 0;
          zIndex = 430;
        } else {
          // Unrelated nodes become grey/dim while the search focus is active.
          // Pattern nodes are kept slightly more visible than fully unrelated nodes
          // so the user can still perceive the active Pattern Discovery context.
          opacity = patternActive && inPattern ? 0.22 : 0.08;
          size = NODE_SIZE * 0.94;
          shadowColor = 'transparent';
          shadowBlur = 0;
          zIndex = patternActive && inPattern ? 80 : 40;
        }
      } else if (patternActive) {
        if (inPattern) {
          opacity = 1;
          size = NODE_SIZE * 1.10;
          shadowColor = 'rgba(255, 255, 255, 0.98)';
          shadowBlur = 34;
          zIndex = 340;
        } else {
          opacity = 0.16;
          size = NODE_SIZE * 0.94;
          zIndex = 40;
        }
      }

      return {
        id: node.id,
        style: {
          x: node.x,
          y: node.y,
          size: [size, size],
          cursor: 'pointer',
          port: true,
          portLineWidth: 0,
          portStroke: 'transparent',
          src: node._sprite,
          opacity,
          shadowColor,
          shadowBlur,
          shadowOffsetX: 0,
          shadowOffsetY: 0,
          pointerEvents: 'auto',
          zIndex
        },
      };
    });
  }

  function computeEdgeStyleUpdates(edges) {
    const C_NEG = d3.select('#edgeNeg').property('value') || '#00FF00';
    const C_ZERO = d3.select('#edgeZero').property('value') || '#D0D0D0';
    const C_POS = d3.select('#edgePos').property('value') || '#FF00FF';

    edges.forEach(e => { e._w = getCurrentEdgeWeight(e); });

    const weights = edges.map(e => e._w).filter(Number.isFinite);
    const negWeights = weights.filter(v => v < 0);
    const posWeights = weights.filter(v => v > 0);
    const negAbsMax = d3.max(negWeights.map(v => Math.abs(v))) ?? 1;
    const posAbsMax = d3.max(posWeights.map(v => Math.abs(v))) ?? 1;

    const negWidthScale = d3.scaleSqrt().domain([0, negAbsMax || 1]).range([2.2, 9.0]).clamp(true);
    const posWidthScale = d3.scaleSqrt().domain([0, posAbsMax || 1]).range([2.2, 9.0]).clamp(true);
    // Use the current Zero picker as the low-strength anchor.
    // This makes the edge color pickers truly authoritative:
    // if Negative / Zero / Positive are all set to white, all edges become white.
    const negColorScale = d3.scaleLinear().domain([0, negAbsMax || 1]).range([C_ZERO, C_NEG]).clamp(true);
    const posColorScale = d3.scaleLinear().domain([0, posAbsMax || 1]).range([C_ZERO, C_POS]).clamp(true);

    let interactColorById = null;
    if (useInteractMode) {
      const ids = Array.from(new Set(edges.filter(e => e.interact_id !== undefined && e.interact_id !== null && e.interact_id !== '').map(e => e.interact_id)));
      interactColorById = new Map();
      ids.forEach((id, i) => interactColorById.set(id, INTERACT_COLORS[i % INTERACT_COLORS.length]));
    }

    const singlecellEdgeMode = isSinglecellMode();
    const singlecellEdgeTypeColorByName = singlecellEdgeMode ? buildEdgeTypeColorMap(edges) : null;

    function baseColor(edge) {
      const v = edge._w;
      if (!Number.isFinite(v)) return C_ZERO || '#CCCCCC';

      // Exact override: when the three edge color pickers are the same color,
      // every edge should use that exact color, independent of weight magnitude.
      if (
        String(C_NEG).toLowerCase() === String(C_ZERO).toLowerCase() &&
        String(C_POS).toLowerCase() === String(C_ZERO).toLowerCase()
      ) {
        return C_ZERO;
      }

      if (v < 0) return negColorScale(Math.abs(v));
      if (v > 0) return posColorScale(Math.abs(v));
      return C_ZERO;
    }

    function edgeStroke(edge) {
      // Initial display:
      //   Single-cell data may use edge type / edge name colors as an automatic default.
      //
      // After the user changes Edge Negative / Zero / Positive:
      //   The color pickers become the highest-priority color source.
      //   This lets the user override the initial automatic edge colors.
      if (edgePickerTouched) {
        return baseColor(edge);
      }

      // Keep the original automatic single-cell edge type / edge name coloring
      // before the user touches the edge color pickers.
      if (singlecellEdgeMode) {
        const edgeTypeName = getEdgeTypeName(edge);
        const c = singlecellEdgeTypeColorByName?.get(edgeTypeName);
        if (c) return c;
      }

      // Keep the original optional interact_id coloring.
      if (useInteractMode) {
        const c = interactColorById?.get(edge.interact_id);
        return c || baseColor(edge);
      }

      // Normal default: edge color follows weight sign and the current
      // Negative / Zero / Positive picker values.
      return baseColor(edge);
    }

    function colorToRgba(color, alpha) {
      const c = d3.color(color);
      if (!c) return undefined;
      c.opacity = alpha;
      return c.formatRgb();
    }

    return edges.map(edge => {
      const related = isEdgeFocused(edge);
      const isNeg = Number.isFinite(edge._w) && edge._w < 0;
      const isPos = Number.isFinite(edge._w) && edge._w > 0;
      const isZero = Number.isFinite(edge._w) && edge._w === 0;

      let stroke = edgeStroke(edge);
      let opacity = isZero ? 0.76 : 1;
      let lineWidth = isZero ? EDGE_ZERO_WIDTH : EDGE_MAIN_WIDTH;

      const patternActive = !!usePatternDiscovery && patternDiscoveryNodeIds instanceof Set;
      const sourceIdForPattern = endpointId(edge.source);
      const targetIdForPattern = endpointId(edge.target);
      const edgeKeyForPattern = edge._patternDiscoveryEdgeKey || patternEdgeKey(edge);
      const edgeInPattern = patternActive && (
        patternDiscoveryEdgeIds.has(edgeKeyForPattern) ||
        (patternDiscoveryNodeIds.has(sourceIdForPattern) && patternDiscoveryNodeIds.has(targetIdForPattern))
      );

      let focusShadowBoost = 0;

      // Priority 1: Node search. Incident edges become bright pink and unrelated
      // edges become grey/dim. This deliberately works on top of Pattern Discovery.
      if (focusedNodeId) {
        if (related) {
          stroke = SEARCH_HIT_COLOR;
          opacity = 1;
          lineWidth += 3.2;
          focusShadowBoost = 18;
        } else {
          opacity = patternActive && edgeInPattern ? 0.18 : 0.055;
          stroke = colorToRgba(stroke, 0.50) || stroke;
          lineWidth = Math.max(0.75, lineWidth * 0.58);
        }
      } else if (patternActive) {
        if (edgeInPattern) {
          opacity = 1;
          lineWidth += 2.4;
          focusShadowBoost = 14;
        } else {
          opacity = 0.16;
          stroke = colorToRgba(stroke, 0.75) || stroke;
          lineWidth = Math.max(1.0, lineWidth * 0.62);
        }
      }

      const arrowSize = Math.max(11, Math.min(18, lineWidth * 2.05));
      const labelText = showEdgeLabels && (
        focusedNodeId ? related : (!patternActive || edgeInPattern)
      ) ? (useInteractMode ? formatSinglecellEdgeLabel(edge) : formatWeight(edge._w)) : '';
      const useLabelBackground = false;
      const shadowColor = focusedNodeId
        ? (related ? 'rgba(255, 43, 214, 0.92)' : 'rgba(255,255,255,0.35)')
        : (patternActive
            ? (edgeInPattern ? 'rgba(255, 255, 255, 0.92)' : 'rgba(255,255,255,0.55)')
            : 'rgba(255,255,255,0.72)');

      return {
        id: edge.id,
        sourcePort: edge._sourcePort || 'p0',
        targetPort: edge._targetPort || 'p36',
        type: edge._edgeType || 'line',
        style: {
          stroke,
          strokeOpacity: opacity,
          lineWidth,
          lineCap: 'round',
          lineJoin: 'round',
          pointerEvents: 'none',
          increasedLineWidthForHitTesting: 0,
          shadowColor,
          shadowBlur: focusedNodeId
            ? (related ? Math.min(38, lineWidth * 2.7 + focusShadowBoost) : Math.max(1.5, lineWidth * 0.7))
            : Math.max(2.2, lineWidth * 0.9 + focusShadowBoost),
          shadowOffsetX: 0,
          shadowOffsetY: 0,
          endArrow: true,
          endArrowType: 'triangle',
          endArrowSize: arrowSize,
          endArrowFill: stroke,
          endArrowStroke: '#ffffff',
          endArrowStrokeOpacity: Math.min(1, opacity + 0.12),
          endArrowLineWidth: Math.max(1.0, lineWidth * 0.18),
          endArrowOffset: Math.max(1.2, lineWidth * 0.14),
          curveOffset: edge._curveOffset || 0,
          curvePosition: edge._curvePosition ?? 0.5,
          labelText,
          labelFill: focusedNodeId && related ? SEARCH_HIT_COLOR : '#0f172a',
          labelFontSize: focusedNodeId && related ? 11.5 : 10.5,
          labelFontFamily: 'Arial, Helvetica, sans-serif',
          labelFontWeight: 800,
          labelPlacement: 'center',
          labelBackground: useLabelBackground,
          labelBackgroundFill: 'rgba(255,255,255,0.90)',
          labelBackgroundStroke: stroke,
          labelBackgroundLineWidth: useLabelBackground ? 0.8 : 0,
          labelBackgroundRadius: 4,
          labelBackgroundPadding: useLabelBackground ? [3, 6, 3, 6] : [0, 0, 0, 0],
          zIndex: focusedNodeId && related ? 70 : (patternActive && edgeInPattern ? 55 : (isNeg ? 3 : isPos ? 2 : 1)),
        },
      };
    });
  }


  function buildNodeUpdates() {
    const currentGraph = getCurrentVisibleGraph(currentData);
    return computeNodeStyleUpdates(currentGraph.nodes);
  }

  function buildEdgeUpdates() {
    const currentGraph = getCurrentVisibleGraph(currentData);
    // Self-loop edges are drawn by the SVG overlay, not by G6.
    // Do not pass self-loop ids to graph.updateEdgeData(), because they are not in G6 edge data.
    const g6Edges = currentGraph.edges.filter(edge => String(edge.source) !== String(edge.target));
    return computeEdgeStyleUpdates(g6Edges);
  }

  function buildG6Data(data) {
    const currentGraph = getCurrentVisibleGraph(data);

    annotateEdgeGeometry(currentGraph.edges);
    assignEdgePorts(currentGraph.nodes, currentGraph.edges);

    currentGraph.edges.forEach(e => { e._w_for_sort = getCurrentEdgeWeight(e); });

    const sortedEdges = currentGraph.edges.slice().sort((a, b) => {
      const aw = Math.abs(a._w_for_sort || 0);
      const bw = Math.abs(b._w_for_sort || 0);
      const aSignGroup = a._w_for_sort < 0 ? 2 : a._w_for_sort > 0 ? 1 : 0;
      const bSignGroup = b._w_for_sort < 0 ? 2 : b._w_for_sort > 0 ? 1 : 0;
      return d3.ascending(aSignGroup, bSignGroup) || d3.ascending(aw, bw);
    });

    const nodeStyleMap = new Map(computeNodeStyleUpdates(currentGraph.nodes).map(item => [String(item.id), item.style]));
    const edgeStyleMap = new Map(computeEdgeStyleUpdates(sortedEdges).map(item => [String(item.id), item]));

    return {
      nodes: currentGraph.nodes.map(node => ({
        id: node.id,
        type: 'image',
        data: { ...node },
        ports: getNodePorts(),
        style: {
          x: node.x,
          y: node.y,
          size: [NODE_SIZE, NODE_SIZE],
          cursor: 'pointer',
          port: true,
          portLineWidth: 0,
          portStroke: 'transparent',
          ...(nodeStyleMap.get(String(node.id)) || { src: node._sprite || renderNodeSprite(node), opacity: 1 }),
        },
      })),
      edges: sortedEdges.filter(edge => String(edge.source) !== String(edge.target)).map(edge => {
        const item = edgeStyleMap.get(String(edge.id));
        return {
          id: edge.id,
          source: edge.source,
          target: edge.target,
          sourcePort: edge._sourcePort || 'p0',
          targetPort: edge._targetPort || 'p36',
          type: edge._edgeType || 'line',
          data: {
            ...edge,
            edgeType: edge._edgeType || 'line',
            curveOffset: edge._curveOffset || 0,
            curvePosition: edge._curvePosition ?? 0.5,
          },
          style: {
            ...(item?.style || {}),
            curveOffset: edge._curveOffset || 0,
            curvePosition: edge._curvePosition ?? 0.5,
          },
        };
      }),
    };
  }

  function getEventNodeId(evt) {
    return String(evt?.target?.id ?? evt?.target?.attributes?.id ?? evt?.item?.id ?? evt?.itemId ?? '');
  }

  function clearFocus() {
    if (!focusedNodeId) return;
    focusedNodeId = null;
    invalidateSprites();
    updateStyles();
    renderSelfLoopOverlay();
  }


  function setGeneSearchStatus(message, isError = false) {
    const el = document.getElementById('geneSearchStatus');
    if (!el) return;
    el.textContent = message || '';
    el.style.color = isError ? '#b91c1c' : '#666';
  }

  function normalizeGeneName(value) {
    return String(Array.isArray(value) ? value[0] : value ?? '')
      .trim()
      .toLowerCase();
  }

  function getNodeSearchNames(node) {
    return [
      node?.id,
      node?.gene,
      node?.name,
      node?.label,
      node?.symbol,
      node?.data?.id,
      node?.data?.gene,
      node?.data?.name,
      node?.data?.label,
      node?.data?.symbol,
    ]
      .map(v => String(Array.isArray(v) ? v[0] : v ?? '').trim())
      .filter(Boolean);
  }

  function findNodeByGeneName(nodes, query) {
    const q = normalizeGeneName(query);
    if (!q) return null;

    // First pass: exact case-insensitive match. This prevents TP53 from matching TP53BP1.
    for (const node of nodes || []) {
      if (getNodeSearchNames(node).some(name => normalizeGeneName(name) === q)) return node;
    }

    // Second pass: allow partial match only when there is a single unambiguous result.
    const partial = (nodes || []).filter(node =>
      getNodeSearchNames(node).some(name => normalizeGeneName(name).includes(q))
    );
    return partial.length === 1 ? partial[0] : null;
  }

  function focusGeneFromSearch() {
    const input = document.getElementById('geneSearchInput');
    const query = input?.value?.trim() || '';

    if (!query) {
      clearFocus();
      setGeneSearchStatus('');
      return;
    }

    if (!currentData || !graph) {
      setGeneSearchStatus('Network is not loaded yet.', true);
      return;
    }

    syncCurrentNodePositionsFromGraph();

    const visibleGraph = getCurrentVisibleGraph(currentData);
    const visibleNode = findNodeByGeneName(visibleGraph.nodes, query);

    if (visibleNode) {
      focusedNodeId = String(getId(visibleNode.id));
      rebuildFocusIndex(visibleGraph);
      invalidateSprites();
      updateStyles();
      renderSelfLoopOverlay();

      const neighborCount = neighborMap.get(focusedNodeId)?.size || 0;
      const relatedEdgeCount = (visibleGraph.edges || []).filter(edge => isEdgeFocused(edge)).length;
      const patternText = usePatternDiscovery ? ' on top of the current Pattern Discovery state' : '';
      setGeneSearchStatus(`Found ${focusedNodeId}: highlighted ${neighborCount} related node(s) and ${relatedEdgeCount} related edge(s)${patternText}.`);
      return;
    }

    const allNode = findNodeByGeneName(currentData.nodes || [], query);
    if (allNode) {
      setGeneSearchStatus(`Found ${getId(allNode.id)}, but it is hidden by the current degree / edge / difference filters. Adjust filters to display it.`, true);
      return;
    }

    setGeneSearchStatus(`No node named "${query}" exists in the current network.`, true);
  }

  function clearGeneSearch() {
    const input = document.getElementById('geneSearchInput');
    if (input) input.value = '';
    setGeneSearchStatus('');
    clearFocus();
  }

  function getLoopOverlayAngles(sideIndex) {
    switch (sideIndex) {
      case 1: return { start: -Math.PI / 6, end: Math.PI / 6, dir: { x: 1, y: 0 } };
      case 2: return { start: Math.PI / 6, end: 5 * Math.PI / 6, dir: { x: 0, y: 1 } };
      case 3: return { start: 5 * Math.PI / 6, end: 7 * Math.PI / 6, dir: { x: -1, y: 0 } };
      case 0:
      default: return { start: -5 * Math.PI / 6, end: -Math.PI / 6, dir: { x: 0, y: -1 } };
    }
  }

  function getSelfLoopOverlayGeometry(node, edge) {
    const sideIndex = edge._selfLoopSide ?? 0;
    const level = edge._selfLoopLevel ?? 0;

    const start = getPortWorldPosition(node, edge._sourcePort || 'p0');
    const end = getPortWorldPosition(node, edge._targetPort || 'p36');
    const mid = { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 };

    let dx = mid.x - node.x;
    let dy = mid.y - node.y;
    let len = Math.hypot(dx, dy);
    if (!Number.isFinite(len) || len < 1e-3) {
      const spec = getLoopOverlayAngles(sideIndex);
      dx = spec.dir.x;
      dy = spec.dir.y;
      len = 1;
    }

    const dir = { x: dx / len, y: dy / len };
    const tangent = { x: -dir.y, y: dir.x };
    const outward = NODE_SIZE * 0.46 + level * (SELF_LOOP_STEP + 4);
    const spread = 14 + level * 3.2 + (sideIndex % 2) * 2.2;
    const tangentSign = sideIndex === 0 || sideIndex === 2 ? 1 : -1;

    const c1 = {
      x: start.x + dir.x * outward + tangent.x * spread * tangentSign,
      y: start.y + dir.y * outward + tangent.y * spread * tangentSign,
    };
    const c2 = {
      x: end.x + dir.x * outward - tangent.x * spread * tangentSign,
      y: end.y + dir.y * outward - tangent.y * spread * tangentSign,
    };

    const t = 0.5;
    const mt = 1 - t;
    const curveMid = {
      x: mt * mt * mt * start.x + 3 * mt * mt * t * c1.x + 3 * mt * t * t * c2.x + t * t * t * end.x,
      y: mt * mt * mt * start.y + 3 * mt * mt * t * c1.y + 3 * mt * t * t * c2.y + t * t * t * end.y,
    };
    const label = {
      x: curveMid.x + dir.x * 5,
      y: curveMid.y + dir.y * 5,
    };
    return { start, c1, c2, end, label };
  }

  function getOverlayWorldBounds(nodes) {
    const xs = nodes.map(n => n.x);
    const ys = nodes.map(n => n.y);
    const minX = (d3.min(xs) ?? 0) - NODE_SIZE * 1.9 - EXPORT_PADDING * 0.35;
    const maxX = (d3.max(xs) ?? 0) + NODE_SIZE * 1.9 + EXPORT_PADDING * 0.35;
    const minY = (d3.min(ys) ?? 0) - NODE_SIZE * 1.9 - EXPORT_PADDING * 0.35;
    const maxY = (d3.max(ys) ?? 0) + NODE_SIZE * 1.9 + EXPORT_PADDING * 0.35;
    return { minX, minY, maxX, maxY };
  }

  function normalizePointLike(value) {
    if (Array.isArray(value)) return { x: Number(value[0]), y: Number(value[1]) };
    if (value && typeof value === 'object') return { x: Number(value.x ?? value[0]), y: Number(value.y ?? value[1]) };
    return { x: NaN, y: NaN };
  }

  function canvasPointToOverlayPoint(point, scaleX = 1, scaleY = 1) {
    const container = document.getElementById('networkViz');
    const rect = container?.getBoundingClientRect?.();
    if (!container || !rect) return { x: point.x * scaleX, y: point.y * scaleY };

    try {
      if (graph && typeof graph.getClientByCanvas === 'function') {
        let client = normalizePointLike(graph.getClientByCanvas([point.x, point.y]));
        if (!Number.isFinite(client.x) || !Number.isFinite(client.y)) {
          client = normalizePointLike(graph.getClientByCanvas({ x: point.x, y: point.y }));
        }
        if (Number.isFinite(client.x) && Number.isFinite(client.y)) {
          return {
            x: (client.x - rect.left) * scaleX,
            y: (client.y - rect.top) * scaleY,
          };
        }
      }

      if (graph && typeof graph.getViewportByCanvas === 'function') {
        const viewport = normalizePointLike(graph.getViewportByCanvas([point.x, point.y]));
        if (Number.isFinite(viewport.x) && Number.isFinite(viewport.y)) {
          return { x: viewport.x * scaleX, y: viewport.y * scaleY };
        }
      }
    } catch (err) {
      console.warn('overlay coordinate conversion failed:', err);
    }

    // Last-resort fallback. This is less accurate under pan/zoom, but prevents crashes
    // on G6 builds that do not expose coordinate conversion helpers.
    return { x: point.x * scaleX, y: point.y * scaleY };
  }

  function getOverlayMapper(nodes, width, height) {
    const container = document.getElementById('networkViz');
    const rect = container?.getBoundingClientRect?.();
    const cssWidth = Math.max(1, rect?.width || container?.clientWidth || width || 1);
    const cssHeight = Math.max(1, rect?.height || container?.clientHeight || height || 1);
    const scaleX = width / cssWidth;
    const scaleY = height / cssHeight;

    return {
      scale: Math.max(scaleX, scaleY),
      scaleX,
      scaleY,
      mapPoint(p) {
        return canvasPointToOverlayPoint(p, scaleX, scaleY);
      }
    };
  }

  function scheduleSelfLoopOverlayRender() {
    if (overlayRenderRAF != null) return;
    overlayRenderRAF = requestAnimationFrame(() => {
      overlayRenderRAF = null;
      renderSelfLoopOverlay();
    });
  }

  function buildSelfLoopOverlayMarkup(width, height) {
    if (!currentData) return '';

    const currentGraph = getCurrentVisibleGraph(currentData);
    computePatternDiscoveryState(currentGraph);
    assignEdgePorts(currentGraph.nodes, currentGraph.edges);
    annotateEdgeGeometry(currentGraph.edges);
    currentGraph.edges.forEach(e => { e._w = getCurrentEdgeWeight(e); });

    const loopEdges = currentGraph.edges.filter(e => String(e.source) === String(e.target));
    if (!loopEdges.length) {
      overlayLoopCache = [];
      return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}"></svg>`;
    }

    const nodeMap = new Map(currentGraph.nodes.map(n => [String(n.id), n]));
    const edgeStyleMap = new Map(computeEdgeStyleUpdates(currentGraph.edges).map(item => [String(item.id), item.style]));
    const mapper = getOverlayMapper(currentGraph.nodes, width, height);
    const parts = [];
    const defs = [];

    overlayLoopCache = loopEdges.map((edge, i) => {
      const node = nodeMap.get(String(edge.source));
      const style = edgeStyleMap.get(String(edge.id)) || {};
      if (!node) return null;
      const g = getSelfLoopOverlayGeometry(node, edge);
      const s = mapper.mapPoint(g.start);
      const c1 = mapper.mapPoint(g.c1);
      const c2 = mapper.mapPoint(g.c2);
      const ept = mapper.mapPoint(g.end);
      const lp = mapper.mapPoint(g.label);
      const stroke = style.stroke || '#2563eb';
      const baseLineWidth = Number.isFinite(style.lineWidth) ? style.lineWidth : EDGE_MAIN_WIDTH;
      const lineWidth = baseLineWidth * mapper.scale;
      const opacity = Number.isFinite(style.strokeOpacity) ? style.strokeOpacity : 1;
      const markerId = `loop-arrow-${i}`;
      const arrowSize = Math.max(11 * mapper.scale, Math.min(17 * mapper.scale, lineWidth * 1.95));
      defs.push(`<marker id="${markerId}" markerWidth="${arrowSize * 1.28}" markerHeight="${arrowSize}" refX="${arrowSize * 0.84}" refY="${arrowSize / 2}" orient="auto" markerUnits="userSpaceOnUse"><path d="M 0 0 L ${arrowSize * 1.08} ${arrowSize / 2} L 0 ${arrowSize} Z" fill="${escapeXml(stroke)}" fill-opacity="${opacity}" stroke="#ffffff" stroke-width="${Math.max(1.0 * mapper.scale, lineWidth * 0.22)}" stroke-linecap="round" stroke-linejoin="round"/></marker>`);
      const path = `M ${s.x} ${s.y} C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${ept.x} ${ept.y}`;
      const labelText = style.labelText || '';
      let labelSvg = '';
      if (labelText) {
        const fontSize = (style.labelFontSize || 10) * mapper.scale;
        const fontFamily = style.labelFontFamily || 'Arial, Helvetica, sans-serif';
        const fontWeight = style.labelFontWeight || 700;
        labelSvg = `<text x="${lp.x}" y="${lp.y + fontSize * 0.32}" text-anchor="middle" font-size="${fontSize}" font-family="${escapeXml(fontFamily)}" font-weight="${fontWeight}" fill="${escapeXml(style.labelFill || '#111')}">${escapeXml(labelText)}</text>`;
      }
      parts.push(`<g><path d="${path}" fill="none" stroke="${escapeXml(stroke)}" stroke-opacity="${opacity}" stroke-width="${lineWidth}" stroke-linecap="round" stroke-linejoin="round" marker-end="url(#${markerId})"></path>${labelSvg}</g>`);
      return { edge, style, path };
    }).filter(Boolean);

    return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}"><defs>${defs.join('')}</defs>${parts.join('')}</svg>`;
  }

  function renderSelfLoopOverlay() {
    const svgEl = document.getElementById('selfLoopOverlay');
    const container = document.getElementById('networkViz');
    if (!svgEl || !container || !currentData || !graph) return;
    const rect = container.getBoundingClientRect();
    const width = Math.max(1, rect.width || container.clientWidth || 1);
    const height = Math.max(1, rect.height || container.clientHeight || 1);
    svgEl.setAttribute('width', width);
    svgEl.setAttribute('height', height);
    svgEl.setAttribute('viewBox', `0 0 ${width} ${height}`);
    const markup = buildSelfLoopOverlayMarkup(width, height);
    svgEl.outerHTML = markup.replace('<svg ', '<svg id="selfLoopOverlay" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:20;" ');
  }

  function getLiveGraphNodePosition(nodeId, nodeDatum = null) {
    // G6 v5 keeps the real, post-drag position in the element state. Using
    // getNodeData().style.x/y may return the old data position in some cases,
    // which caused Pattern Discovery style updates to snap nodes back to the
    // initial layout when number-input spinner arrows were clicked repeatedly.
    const id = String(nodeId ?? '');
    if (!graph || !id) return null;

    try {
      if (typeof graph.getElementPosition === 'function') {
        const p = graph.getElementPosition(id);
        if (Array.isArray(p) && Number.isFinite(+p[0]) && Number.isFinite(+p[1])) {
          return { x: +p[0], y: +p[1] };
        }
        if (p && Number.isFinite(+p.x) && Number.isFinite(+p.y)) {
          return { x: +p.x, y: +p.y };
        }
      }
    } catch (err) {}

    try {
      if (typeof graph.getNodeData === 'function') {
        const d = graph.getNodeData(id);
        const item = Array.isArray(d) ? d[0] : d;
        const x = toNum(item?.style?.x ?? item?.x);
        const y = toNum(item?.style?.y ?? item?.y);
        if (Number.isFinite(x) && Number.isFinite(y)) return { x, y };
      }
    } catch (err) {}

    try {
      const all = typeof graph.getNodeData === 'function' ? (graph.getNodeData() || []) : [];
      const item = all.find(n => String(n?.id) === id);
      const x = toNum(item?.style?.x ?? item?.x);
      const y = toNum(item?.style?.y ?? item?.y);
      if (Number.isFinite(x) && Number.isFinite(y)) return { x, y };
    } catch (err) {}

    const fallbackX = toNum(nodeDatum?.x);
    const fallbackY = toNum(nodeDatum?.y);
    if (Number.isFinite(fallbackX) && Number.isFinite(fallbackY)) return { x: fallbackX, y: fallbackY };
    return null;
  }

  function syncCurrentNodePositionsFromGraph() {
    if (!graph || !currentData) return;
    try {
      currentData.nodes.forEach(n => {
        const id = String(getId(n.id));
        const p = getLiveGraphNodePosition(id, n);
        if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
          n.x = p.x;
          n.y = p.y;
        }
      });
    } catch (err) {
      console.warn('syncCurrentNodePositionsFromGraph failed:', err);
    }
  }

  function getCommunityStateKey(id = null) {
    const value = id ?? d3.select('#commSelect').property('value') ?? currentCommId ?? '';
    return String(value);
  }

  function rememberCurrentNodePositions(key = getCommunityStateKey()) {
    if (!currentData || !Array.isArray(currentData.nodes)) return;

    const k = String(key || '');
    if (!k) return;

    if (!nodePositionStoreByCommunity.has(k)) {
      nodePositionStoreByCommunity.set(k, new Map());
    }

    const store = nodePositionStoreByCommunity.get(k);

    currentData.nodes.forEach(node => {
      const id = getId(node.id);
      if (!id) return;

      const x = +node.x;
      const y = +node.y;

      if (Number.isFinite(x) && Number.isFinite(y)) {
        store.set(String(id), { x, y });
      }
    });
  }

  function applyRememberedNodePositions(data, key = getCommunityStateKey()) {
    const store = nodePositionStoreByCommunity.get(String(key || ''));
    if (!store || !data || !Array.isArray(data.nodes)) return;

    data.nodes.forEach(node => {
      const p = store.get(String(getId(node.id)));
      if (isFiniteXY(p)) {
        node.x = +p.x;
        node.y = +p.y;
      }
    });
  }

  function hasAnyFiniteNodePosition(data) {
    return !!(data && Array.isArray(data.nodes) && data.nodes.some(n => Number.isFinite(+n.x) && Number.isFinite(+n.y)));
  }

  function placeMissingNodesNearExisting(data) {
    if (!data || !Array.isArray(data.nodes) || !data.nodes.length) return;

    const existing = data.nodes.filter(n => Number.isFinite(+n.x) && Number.isFinite(+n.y));
    const missing = data.nodes.filter(n => !Number.isFinite(+n.x) || !Number.isFinite(+n.y));

    if (!missing.length) return;

    // If no previous layout exists, fall back to a full layout once.
    if (!existing.length) {
      computeLayoutOnce(data);
      return;
    }

    const xs = existing.map(n => +n.x);
    const ys = existing.map(n => +n.y);
    const cx = d3.mean(xs);
    const cy = d3.mean(ys);
    const spanX = (d3.max(xs) ?? cx) - (d3.min(xs) ?? cx);
    const spanY = (d3.max(ys) ?? cy) - (d3.min(ys) ?? cy);
    const baseR = Math.max(NODE_SIZE * 1.8, 0.45 * Math.max(spanX, spanY, NODE_SIZE * 3));

    missing.forEach((node, i) => {
      node.id = getId(node.id);
      const angle = -Math.PI / 2 + i * 2 * Math.PI / Math.max(missing.length, 1);
      const ring = Math.floor(i / Math.max(1, Math.ceil(Math.sqrt(missing.length))));
      const r = baseR + ring * NODE_SIZE * 1.35;
      node.x = cx + r * Math.cos(angle);
      node.y = cy + r * Math.sin(angle);
    });

    relaxNodeCollisions(data.nodes, NODE_SIZE * 0.82, 40);
  }


  async function refreshGraphData({ fit = false, syncBeforeUpdate = true } = {}) {
    if (!graph || !currentData) return;

    // Normally we capture live positions before replacing graph data, so filters do not snap back.
    // But when a new layout has just been computed in currentData, syncing here would overwrite
    // those fresh x/y values with the old canvas positions. Layout switching must therefore call
    // refreshGraphData({ syncBeforeUpdate: false }).
    if (syncBeforeUpdate) {
      syncCurrentNodePositionsFromGraph();
      rememberCurrentNodePositions();
    }

    const g6data = buildG6Data(currentData);
    graph.setData(g6data);
    await Promise.resolve(graph.render());

    updateStyles();
    rememberCurrentNodePositions();

    if (fit) {
      await graph.fitView({ when: 'always', direction: 'both', padding: 8 });
      syncCurrentNodePositionsFromGraph();
      rememberCurrentNodePositions();
      renderSelfLoopOverlay();
    } else {
      renderSelfLoopOverlay();
    }
  }

  function ensureGraph() {
    if (graph) return graph;

    graph = new Graph({
      container: 'networkViz',
      autoResize: true,
      background: '#fff',
      enableStack: true,
      padding: 8,
      animation: false,
      autoFit: false,
      zoomRange: [0.15, 8],
      devicePixelRatio: Math.min((window.devicePixelRatio || 2) * 2, 6),
      node: { type: 'image' },
      edge: {
        type: datum => datum?.data?.edgeType || 'line',
        style: {
          lineCap: 'round',
          lineJoin: 'round',
          // Keep edges from capturing mouse/touch events so nodes remain draggable even when an edge is drawn over them.
          pointerEvents: 'none',
          increasedLineWidthForHitTesting: 0,
          endArrow: true,
          endArrowType: 'triangle',
          curveOffset: datum => datum?.data?.curveOffset || 0,
          curvePosition: datum => datum?.data?.curvePosition ?? 0.5,
          labelPlacement: 'center',
        },
      },
      behaviors: [
        { type: 'drag-canvas', key: 'drag-canvas' },
        { type: 'zoom-canvas', key: 'zoom-canvas' },
        { type: 'drag-element', key: 'drag-element', enable: event => event.targetType === 'node' },
        { type: 'optimize-viewport-transform', key: 'optimize' },
      ],
    });

    graph.on('node:click', evt => {
      const id = getEventNodeId(evt);
      if (!id) return;
      focusedNodeId = id;
      invalidateSprites();
      updateStyles();
      renderSelfLoopOverlay();
    });

    graph.on('node:dblclick', clearFocus);
    graph.on('canvas:click', clearFocus);
    graph.on('canvas:dblclick', clearFocus);

    graph.on('node:drag', () => {
      syncCurrentNodePositionsFromGraph();
      scheduleSelfLoopOverlayRender();
    });

    graph.on('node:dragend', () => {
      syncCurrentNodePositionsFromGraph();
      if (currentData) {
        assignEdgePorts(currentData.nodes, currentData.edges);
        annotateEdgeGeometry(currentData.edges);
      }
      updateStyles();
      renderSelfLoopOverlay();
    });

    window.addEventListener('keydown', e => {
      if (e.key === 'Escape') clearFocus();
    });

    const networkVizEl = document.getElementById('networkViz');
    if (networkVizEl && !networkVizEl.dataset.selfLoopOverlayListeners) {
      networkVizEl.dataset.selfLoopOverlayListeners = '1';
      // Keep the live page lightweight. Avoid redrawing the SVG overlay on every mousemove/pointermove.
      // Node dragend and graph viewport events still refresh the overlay when needed.
      ['wheel', 'pointerup', 'mouseleave'].forEach(eventName => {
        networkVizEl.addEventListener(eventName, scheduleSelfLoopOverlayRender, { passive: true });
      });
    }

    ['afterrender', 'afterdraw', 'aftertransform', 'viewportchange'].forEach(eventName => {
      try { graph.on(eventName, scheduleSelfLoopOverlayRender); } catch (err) {}
    });

    return graph;
  }

  function updateStyles() {
    if (!currentData || !graph) return;

    getColorScales();
    syncCurrentNodePositionsFromGraph();

    const currentGraph = getCurrentVisibleGraph(currentData);
    assignEdgePorts(currentGraph.nodes, currentGraph.edges);
    annotateEdgeGeometry(currentGraph.edges);
    rebuildFocusIndex(currentGraph);

    graph.updateNodeData(buildNodeUpdates());

    const edgeUpdates = buildEdgeUpdates();
    if (edgeUpdates.length) {
      try {
        const existingEdgeIds = new Set((graph.getEdgeData ? graph.getEdgeData() : []).map(edge => String(edge.id)));
        const safeEdgeUpdates = edgeUpdates.filter(edge => existingEdgeIds.has(String(edge.id)));
        if (safeEdgeUpdates.length) graph.updateEdgeData(safeEdgeUpdates);
      } catch (err) {
        console.warn('safe edge update fallback:', err);
        const safeEdgeUpdates = edgeUpdates.filter(edge => String(edge.source) !== String(edge.target));
        if (safeEdgeUpdates.length) graph.updateEdgeData(safeEdgeUpdates);
      }
    }

    graph.draw();
    renderSelfLoopOverlay();
  }

  async function renderCommunity({
    recomputeLayout = false,
    fit = false,
    resetFocus = false,
    resetEdgeRange = false,
  } = {}) {
    const sel = d3.select('#commSelect');
    const id = String(sel.property('value') || '');
    if (!id) return;

    const previousCommId = currentCommId == null ? null : String(currentCommId);
    const networkChanged = previousCommId !== null && previousCommId !== id;
    const firstRenderForNetwork = !layoutInitializedByCommunity.has(id);

    // Keep current node positions before rebuilding from the raw community JSON.
    syncCurrentNodePositionsFromGraph();
    if (previousCommId !== null) rememberCurrentNodePositions(previousCommId);

    currentCommId = id;
    currentLayoutMode = getLayoutMode();

    if (networkChanged || resetFocus) {
      focusedNodeId = null;
      invalidateSprites();
    }

    const dMinInput = +d3.select('#degMin').property('value');
    const dMaxInput = +d3.select('#degMax').property('value');
    let dmin = Number.isFinite(dMinInput) ? dMinInput : 0;
    let dmax = Number.isFinite(dMaxInput) ? dMaxInput : Infinity;
    if (dmin > dmax) [dmin, dmax] = [dmax, dmin];

    const raw = window.allCommunities.find(d => String(d.comm) === id);

    if (!raw) {
      console.warn('community does not exist:', id);
      return;
    }

    // IMPORTANT:
    // Do not reset edgeFilterApplied here.
    // Old behavior did: edgeFilterApplied = false;
    // That caused Edge Filter -> Degree Range to return to the unfiltered/original state.
    const filtered = buildFilteredCommunity(raw, dmin, dmax);

    let preSelectedSampleIndices = null;
    if (useDifferenceDisplay) {
      preSelectedSampleIndices = computeGlobalDifferenceDisplayIndices(filtered.nodes);
    } else if (useSimilarityDisplay) {
      preSelectedSampleIndices = computeGlobalSimilarityDisplayIndices(filtered.nodes);
    }

    const autoFiltered = applyAutoNodeFilterByDisplayedSamples(filtered, preSelectedSampleIndices);
    const data = sanitizeForG6(autoFiltered);

    // Recompute directed Min-Max edge normalization from w_raw for the current directed graph.
    // This overwrites JSON-provided w_norm with (w_raw - wMin) / (wMax - wMin).
    recomputeDirectedEdgeMinMaxNorm(data);

    updatePatternDiscoveryControlsForData(data);
    computePatternDiscoveryState(data);

    // Continue from the previous layout whenever possible.
    applyRememberedNodePositions(data, id);

    const needsFullLayout =
      recomputeLayout ||
      firstRenderForNetwork ||
      !hasAnyFiniteNodePosition(data);

    if (needsFullLayout) {
      computeLayoutOnce(data);
      layoutInitializedByCommunity.add(id);
    } else {
      placeMissingNodesNearExisting(data);
    }

    assignEdgePorts(data.nodes, data.edges);
    annotateEdgeGeometry(data.edges);

    currentData = data;
    window.currentData = currentData;
    rememberCurrentNodePositions(id);

    globalDifferenceDisplayIndices = useDifferenceDisplay
      ? (Array.isArray(preSelectedSampleIndices) ? preSelectedSampleIndices : computeGlobalDifferenceDisplayIndices(data.nodes))
      : computeGlobalDifferenceDisplayIndices(data.nodes);

    globalSimilarityDisplayIndices = useSimilarityDisplay
      ? (Array.isArray(preSelectedSampleIndices) ? preSelectedSampleIndices : computeGlobalSimilarityDisplayIndices(data.nodes))
      : computeGlobalSimilarityDisplayIndices(data.nodes);

    updateSimilarityDisplayStatus(globalSimilarityDisplayIndices, data.nodes);

    rebuildFocusIndex(data);
    invalidateSprites();
    updateValueRangeInputs(data.nodes);

    // Do not overwrite edge range after every degree/data refresh.
    // Only initialize/reset it when explicitly requested or before any edge filter is active.
    if (resetEdgeRange || (!edgeFilterApplied && (firstRenderForNetwork || networkChanged))) {
      setEdgeRangeInputs(data.edges);
    }

    renderStageLegend();
    ensureGraph();

    await refreshGraphData({
      fit: fit || firstRenderForNetwork || networkChanged,
      syncBeforeUpdate: !needsFullLayout,
    });
  }

  async function svgMarkupToDataURL(svgMarkup) {
    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgMarkup);
  }

  async function getExactG6SnapshotDataURL(pixelRatio = EXPORT_PNG_PIXEL_RATIO) {
    if (!graph) throw new Error('Graph is not initialized.');

    syncCurrentNodePositionsFromGraph();
    rebuildNodeSpritesIfNeeded();
    updateStyles();
    renderSelfLoopOverlay();
    await Promise.resolve();

    const container = document.getElementById('networkViz');
    const rect = container.getBoundingClientRect();
    const cssWidth = Math.max(1, Math.round(rect.width));
    const cssHeight = Math.max(1, Math.round(rect.height));

    let baseDataURL = null;

    // Prefer G6's own high-DPI export. This asks the renderer to produce a
    // higher-resolution image instead of merely scaling up the visible DOM canvas.
    try {
      baseDataURL = await graph.toDataURL({
        mode: 'viewport',
        type: 'image/png',
        pixelRatio,
        backgroundColor: '#ffffff',
      });
    } catch (err1) {
      try {
        baseDataURL = await graph.toDataURL({
          mode: 'overall',
          type: 'image/png',
          pixelRatio,
          backgroundColor: '#ffffff',
        });
      } catch (err2) {
        console.warn('G6 high-DPI export failed, falling back to visible canvas composite:', err1, err2);
      }
    }

    if (baseDataURL) {
      const baseImg = new Image();
      await new Promise((resolve, reject) => {
        baseImg.onload = resolve;
        baseImg.onerror = reject;
        baseImg.src = baseDataURL;
      });

      const width = baseImg.naturalWidth || Math.round(cssWidth * pixelRatio);
      const height = baseImg.naturalHeight || Math.round(cssHeight * pixelRatio);

      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = width;
      exportCanvas.height = height;
      const ctx = exportCanvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(baseImg, 0, 0, width, height);

      // Draw the self-loop overlay as vector SVG at the same high pixel size.
      const overlayMarkup = buildSelfLoopOverlayMarkup(width, height);
      if (overlayMarkup) {
        const overlayImg = new Image();
        const overlayURL = await svgMarkupToDataURL(overlayMarkup);
        await new Promise((resolve, reject) => {
          overlayImg.onload = resolve;
          overlayImg.onerror = reject;
          overlayImg.src = overlayURL;
        });
        ctx.drawImage(overlayImg, 0, 0, width, height);
      }

      return exportCanvas.toDataURL('image/png');
    }

    // Final fallback: composite visible DOM canvases. This is less sharp because it
    // cannot create details that are not present in the current visible canvas.
    const exportCanvas = document.createElement('canvas');
    exportCanvas.width = Math.max(1, Math.round(cssWidth * pixelRatio));
    exportCanvas.height = Math.max(1, Math.round(cssHeight * pixelRatio));
    const ctx = exportCanvas.getContext('2d');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

    const canvases = Array.from(container.querySelectorAll('canvas'));
    canvases.forEach(cv => {
      try {
        ctx.drawImage(cv, 0, 0, exportCanvas.width, exportCanvas.height);
      } catch (err) {
        console.warn('draw canvas layer failed:', err);
      }
    });

    const overlayMarkup = buildSelfLoopOverlayMarkup(exportCanvas.width, exportCanvas.height);
    if (overlayMarkup) {
      const img = new Image();
      const overlayURL = await svgMarkupToDataURL(overlayMarkup);
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = reject;
        img.src = overlayURL;
      });
      ctx.drawImage(img, 0, 0, exportCanvas.width, exportCanvas.height);
    }

    return exportCanvas.toDataURL('image/png');
  }

  function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  function dataURLToBlob(dataURL) {
    const [head, content] = dataURL.split(',');
    const contentType = head.match(/:(.*?);/)?.[1] || 'application/octet-stream';
    const binary = atob(content);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new Blob([bytes], { type: contentType });
  }

  function getPngSizeFromDataURL(dataURL) {
    try {
      const comma = dataURL.indexOf(',');
      if (comma < 0 || !dataURL.slice(0, comma).includes('image/png')) return null;

      const binary = atob(dataURL.slice(comma + 1));
      if (binary.length < 24) return null;

      // PNG signature + IHDR width/height at byte offsets 16 and 20, big-endian.
      const width =
        (binary.charCodeAt(16) << 24) |
        (binary.charCodeAt(17) << 16) |
        (binary.charCodeAt(18) << 8) |
        binary.charCodeAt(19);

      const height =
        (binary.charCodeAt(20) << 24) |
        (binary.charCodeAt(21) << 16) |
        (binary.charCodeAt(22) << 8) |
        binary.charCodeAt(23);

      if (Number.isFinite(width) && Number.isFinite(height) && width > 0 && height > 0) {
        return { width, height };
      }
    } catch (err) {
      console.warn('getPngSizeFromDataURL failed:', err);
    }
    return null;
  }

  function stripOuterSvgToInner(svgMarkup) {
    if (!svgMarkup) return '';
    return String(svgMarkup)
      .replace(/^<svg\b[^>]*>/i, '')
      .replace(/<\/svg>\s*$/i, '');
  }

  function getImageSizeFromDataURL(dataURL) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve({ width: img.naturalWidth || img.width, height: img.naturalHeight || img.height });
      img.onerror = reject;
      img.src = dataURL;
    });
  }

  async function savePNG() {
    syncCurrentNodePositionsFromGraph();
    rebuildNodeSpritesIfNeeded();
    updateStyles();
    await Promise.resolve();

    const svgText = buildSvgMarkup();
    const widthMatch = svgText.match(/width="([\d.]+)"/);
    const heightMatch = svgText.match(/height="([\d.]+)"/);
    const width = Math.max(1, Math.round(Number(widthMatch?.[1] || 1600)));
    const height = Math.max(1, Math.round(Number(heightMatch?.[1] || 1200)));

    const svgBlob = new Blob([svgText], { type: 'image/svg+xml;charset=utf-8' });
    const svgUrl = URL.createObjectURL(svgBlob);

    try {
      const img = new Image();
      await new Promise((resolve, reject) => {
        img.onload = resolve;
        img.onerror = reject;
        img.src = svgUrl;
      });

      const ratio = EXPORT_FULL_GRAPH_PIXEL_RATIO;
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(width * ratio));
      canvas.height = Math.max(1, Math.round(height * ratio));
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

      canvas.toBlob(blob => {
        if (blob) downloadBlob(blob, `${currentCommId || 'community'}_full_graph_hd.png`);
      }, 'image/png');
    } finally {
      URL.revokeObjectURL(svgUrl);
    }
  }

  function getPortPlacementByKey(key) {
    const hit = NODE_PORTS_META.find(p => p.key === key);
    return hit ? hit.placement : [0.5, 0.5];
  }

  function getPortWorldPosition(node, portKey) {
    const [px, py] = getPortPlacementByKey(portKey);
    return {
      x: node.x + (px - 0.5) * NODE_SIZE,
      y: node.y + (py - 0.5) * NODE_SIZE,
    };
  }

  function getQuadraticControlPoint(p1, p2, offset) {
    const mx = (p1.x + p2.x) / 2;
    const my = (p1.y + p2.y) / 2;
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const len = Math.hypot(dx, dy) || 1;
    const nx = -dy / len;
    const ny = dx / len;
    return { x: mx + nx * offset, y: my + ny * offset };
  }

  function getSelfLoopPath(node, edge) {
    const g = getSelfLoopOverlayGeometry(node, edge);
    return `M ${g.start.x} ${g.start.y} C ${g.c1.x} ${g.c1.y}, ${g.c2.x} ${g.c2.y}, ${g.end.x} ${g.end.y}`;
  }

  function getEdgeSvgPath(edge, nodeMap) {
    const s = nodeMap.get(String(edge.source));
    const t = nodeMap.get(String(edge.target));
    if (!s || !t) return '';

    if (String(edge.source) === String(edge.target)) return getSelfLoopPath(s, edge);

    const p1 = getPortWorldPosition(s, edge._sourcePort || 'p0');
    const p2 = getPortWorldPosition(t, edge._targetPort || 'p36');

    if ((edge._edgeType || 'line') === 'quadratic') {
      const c = getQuadraticControlPoint(p1, p2, edge._curveOffset || 0);
      return `M ${p1.x} ${p1.y} Q ${c.x} ${c.y} ${p2.x} ${p2.y}`;
    }
    return `M ${p1.x} ${p1.y} L ${p2.x} ${p2.y}`;
  }

  function getEdgeLabelPosition(edge, nodeMap) {
    const s = nodeMap.get(String(edge.source));
    const t = nodeMap.get(String(edge.target));
    if (!s || !t) return null;

    if (String(edge.source) === String(edge.target)) return getSelfLoopOverlayGeometry(s, edge).label;

    const p1 = getPortWorldPosition(s, edge._sourcePort || 'p0');
    const p2 = getPortWorldPosition(t, edge._targetPort || 'p36');

    if ((edge._edgeType || 'line') === 'quadratic') {
      const c = getQuadraticControlPoint(p1, p2, edge._curveOffset || 0);
      const t0 = 0.5;
      const x = (1 - t0) * (1 - t0) * p1.x + 2 * (1 - t0) * t0 * c.x + t0 * t0 * p2.x;
      const y = (1 - t0) * (1 - t0) * p1.y + 2 * (1 - t0) * t0 * c.y + t0 * t0 * p2.y;
      return { x, y };
    }

    return { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
  }

  function escapeXml(str) {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&apos;');
  }

  function makeSvgEdgeMarker(markerId, stroke, opacity, lineWidth, arrowSize) {
    const size = Number.isFinite(arrowSize) ? arrowSize : Math.max(11, Math.min(17, lineWidth * 1.95));
    const markerStrokeWidth = Math.max(1.0, lineWidth * 0.22);
    return `
      <marker
        id="${markerId}"
        markerWidth="${size * 1.28}"
        markerHeight="${size}"
        refX="${size * 0.84}"
        refY="${size / 2}"
        orient="auto"
        markerUnits="userSpaceOnUse">
        <path
          d="M 0 0 L ${size * 1.08} ${size / 2} L 0 ${size} Z"
          fill="${escapeXml(stroke)}"
          fill-opacity="${opacity}"
          stroke="#ffffff"
          stroke-width="${markerStrokeWidth}"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </marker>`;
  }

  function buildSvgMarkup() {
    if (!currentData) return '';

    getColorScales();
    syncCurrentNodePositionsFromGraph();
    rebuildNodeSpritesIfNeeded();

    const exportGraph = getCurrentVisibleGraph(currentData);
    assignEdgePorts(exportGraph.nodes, exportGraph.edges);
    annotateEdgeGeometry(exportGraph.edges);

    // Keep export layering consistent with the on-screen G6 rendering.
    exportGraph.edges.forEach(e => { e._w_for_sort = getCurrentEdgeWeight(e); });
    const sortedEdges = exportGraph.edges.slice().sort((a, b) => {
      const aw = Math.abs(a._w_for_sort || 0);
      const bw = Math.abs(b._w_for_sort || 0);
      const aSignGroup = a._w_for_sort < 0 ? 2 : a._w_for_sort > 0 ? 1 : 0;
      const bSignGroup = b._w_for_sort < 0 ? 2 : b._w_for_sort > 0 ? 1 : 0;
      return d3.ascending(aSignGroup, bSignGroup) || d3.ascending(aw, bw);
    });

    const nodeUpdates = computeNodeStyleUpdates(exportGraph.nodes);
    const edgeUpdates = computeEdgeStyleUpdates(sortedEdges);
    const nodeStyleMap = new Map(nodeUpdates.map(n => [String(n.id), n.style]));
    const edgeStyleMap = new Map(edgeUpdates.map(e => [String(e.id), e.style]));
    const nodeMap = new Map(exportGraph.nodes.map(n => [String(n.id), n]));

    const xs = exportGraph.nodes.map(n => n.x);
    const ys = exportGraph.nodes.map(n => n.y);
    if (!xs.length || !ys.length) return '';

    const minX = Math.min(...xs) - NODE_SIZE - EXPORT_PADDING;
    const minY = Math.min(...ys) - NODE_SIZE - EXPORT_PADDING;
    const maxX = Math.max(...xs) + NODE_SIZE + EXPORT_PADDING;
    const maxY = Math.max(...ys) + NODE_SIZE + EXPORT_PADDING;
    const width = maxX - minX;
    const height = maxY - minY;

    const defs = [];

    const edgeSvg = sortedEdges.map((edge, i) => {
      const style = edgeStyleMap.get(String(edge.id)) || {};
      const path = getEdgeSvgPath(edge, nodeMap);
      if (!path) return '';

      const stroke = style.stroke || '#999';
      const opacity = Number.isFinite(style.strokeOpacity) ? style.strokeOpacity : 1;
      const lineWidth = Number.isFinite(style.lineWidth) ? style.lineWidth : 1.2;
      const arrowSize = Number.isFinite(style.endArrowSize) ? style.endArrowSize : Math.max(8, Math.min(22, lineWidth * 1.8));
      const markerId = `arrow-${i}`;
      defs.push(makeSvgEdgeMarker(markerId, stroke, opacity, lineWidth, arrowSize));

      const labelText = style.labelText || '';
      const labelPos = labelText ? getEdgeLabelPosition(edge, nodeMap) : null;
      const labelFontSize = style.labelFontSize || 10;
      const fontFamily = style.labelFontFamily || 'Arial, Helvetica, sans-serif';
      const fontWeight = style.labelFontWeight || 700;
      const labelFill = style.labelFill || '#111';

      let labelSvg = '';
      if (labelText && labelPos) {
        const text = escapeXml(labelText);
        if (style.labelBackground) {
          const approxW = Math.max(28, text.length * labelFontSize * 0.62 + 10);
          const approxH = labelFontSize + 8;
          labelSvg = `
            <g>
              <rect
                x="${labelPos.x - approxW / 2}"
                y="${labelPos.y - approxH / 2}"
                width="${approxW}"
                height="${approxH}"
                rx="${style.labelBackgroundRadius || 4}"
                ry="${style.labelBackgroundRadius || 4}"
                fill="${escapeXml(style.labelBackgroundFill || 'rgba(255,255,255,0.88)')}"
                stroke="${escapeXml(style.labelBackgroundStroke || stroke)}"
                stroke-width="${style.labelBackgroundLineWidth || 0.8}"></rect>
              <text
                x="${labelPos.x}"
                y="${labelPos.y + labelFontSize * 0.32}"
                text-anchor="middle"
                font-size="${labelFontSize}"
                font-family="${escapeXml(fontFamily)}"
                font-weight="${fontWeight}"
                fill="${escapeXml(labelFill)}">${text}</text>
            </g>`;
        } else {
          labelSvg = `
            <text
              x="${labelPos.x}"
              y="${labelPos.y + labelFontSize * 0.32}"
              text-anchor="middle"
              font-size="${labelFontSize}"
              font-family="${escapeXml(fontFamily)}"
              font-weight="${fontWeight}"
              fill="${escapeXml(labelFill)}">${text}</text>`;
        }
      }

      return `
        <g>
          <path
            d="${path}"
            fill="none"
            stroke="${escapeXml(stroke)}"
            stroke-width="${lineWidth}"
            stroke-opacity="${opacity}"
            stroke-linecap="round"
            stroke-linejoin="round"
            marker-end="url(#${markerId})"></path>
          ${labelSvg}
        </g>`;
    }).join('');

    const nodeSvg = exportGraph.nodes.map(node => {
      const style = nodeStyleMap.get(String(node.id)) || {};
      const opacity = Number.isFinite(style.opacity) ? style.opacity : 1;
      const src = style.src || node._sprite || renderNodeSprite(node);
      const x = node.x - NODE_SIZE / 2;
      const y = node.y - NODE_SIZE / 2;
      return `
        <image
          href="${src}"
          x="${x}"
          y="${y}"
          width="${NODE_SIZE}"
          height="${NODE_SIZE}"
          opacity="${opacity}"
          preserveAspectRatio="xMidYMid meet"></image>`;
    }).join('');

    return `<?xml version="1.0" encoding="UTF-8"?>
<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  width="${width}"
  height="${height}"
  viewBox="${minX} ${minY} ${width} ${height}">
  <defs>
    ${defs.join('\n')}
  </defs>
  <rect x="${minX}" y="${minY}" width="${width}" height="${height}" fill="#ffffff"></rect>
  ${edgeSvg}
  ${nodeSvg}
</svg>`;
  }

