        </label>
        <span id="autoNodeFilterStatus" class="hint">Selects diverse samples by mixed global-local distance; no Data1/Data2 thresholds.</span>
      </div>

      <div id="similarityDisplayRow" style="
        display:flex;
        width:100%;
        margin-top:8px;
        margin-left:0;
        margin-right:0;
        clear:both;
        justify-content:flex-start;
        align-items:center;
        gap:24px;
      ">
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          <input type="checkbox" id="similarityDisplayToggle">
          Similarity displaying
        </label>
        <label style="display:inline-flex; align-items:center; gap:6px; margin:0;">
          Samples per group:
          <input type="number" id="similaritySampleCount" value="8" min="1" max="100" step="1" style="width:70px;">
        </label>
        <span id="similarityDisplayStatus" class="hint">Selects coherent samples by mixed global-local distance; no Data1/Data2 thresholds.</span>
      </div>
    </div>

    <br>

    <div class="legend-row" style="margin-top:8px;">
      <span>Group:</span>
      <span id="stageLegend" class="legend-inline"></span>
    </div>

    <br>

    <div>
      <span>Edges:</span>
      Negative:
      <input type="color" id="edgeNeg" value="#00FF00" title="Negative weight" />
      Zero:
      <input type="color" id="edgeZero" value="#D0D0D0" title="Zero weight" />
      Positive:
      <input type="color" id="edgePos" value="#FF00FF" title="Positive Weight" />

      <label style="margin-left:12px;">
        <input type="checkbox" id="showEdgeLabels" checked>
        show edge weights
      </label>
    </div>

    <br>

    <div style="margin-top:8px;">
      <span>Edge Data Norm:</span>
      <select id="edgeMetric">
        <option value="w_raw">Raw</option>
        <option value="w_norm" selected>Min-Max Norm</option>
        <option value="w_z">Z-score</option>
      </select>

      <label style="margin-left:12px;">
        Range:
        <input type="number" id="eRangeMin" value="0" step="0.00000001" style="width:120px;">
        –
