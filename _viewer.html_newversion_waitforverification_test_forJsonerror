      bindDisplaySampleCountInput('#differenceSampleCount', 'difference');
      bindDisplaySampleCountInput('#similaritySampleCount', 'similarity');

      function syncPatternPair(sliderSelector, inputSelector, onChange) {
        const slider = d3.select(sliderSelector);
        const input = d3.select(inputSelector);
        if (slider.empty() || input.empty()) return;

        function clampAndSyncFromInput() {
          let v = +input.property('value');
          const min = +input.property('min');
          const max = +input.property('max');
          if (!Number.isFinite(v)) v = Number.isFinite(min) ? min : 0;
          v = Math.min(max, Math.max(min, v));
          const step = +input.property('step');
          const digits = step < 0.1 ? 2 : 1;
          input.property('value', v.toFixed(digits));
          slider.property('value', v.toFixed(digits));
          if (typeof onChange === 'function') onChange();
        }

        // Stop double-click/wheel events inside controls from leaking to the G6 canvas.
        // This prevents accidental layout/view reset when users double-click the
        // number-input spinner arrows.
        [slider, input].forEach(sel => {
          sel.on('dblclick.patternDiscoveryStop', function (event) { event.stopPropagation(); })
             .on('mousedown.patternDiscoveryStop', function (event) { event.stopPropagation(); })
             .on('pointerdown.patternDiscoveryStop', function (event) { event.stopPropagation(); })
             .on('wheel.patternDiscoveryStop', function (event) { event.stopPropagation(); });
        });

        slider.on('input', function () {
          input.property('value', this.value);
          if (typeof onChange === 'function') onChange();
        });

        // Number input spinner arrows fire input events continuously in most browsers.
        input.on('input', clampAndSyncFromInput);
        input.on('change', clampAndSyncFromInput);
      }

      function snapshotGraphNodePositions() {
        const pos = new Map();
        if (!graph) return pos;
        try {
          const ids = currentData && Array.isArray(currentData.nodes)
            ? currentData.nodes.map(n => String(getId(n.id)))
            : (typeof graph.getNodeData === 'function' ? (graph.getNodeData() || []).map(n => String(n.id)) : []);

          ids.forEach(id => {
            const currentNode = currentData?.nodes?.find?.(n => String(getId(n.id)) === id) || null;
            const p = getLiveGraphNodePosition(id, currentNode);
            if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
              pos.set(String(id), { x: p.x, y: p.y });
            }
          });
        } catch (err) {
          console.warn('snapshotGraphNodePositions failed:', err);
        }
        return pos;
      }

      function applyPositionSnapshotToCurrentData(pos) {
        if (!currentData || !Array.isArray(currentData.nodes) || !pos || !pos.size) return;
        currentData.nodes.forEach(n => {
          const p = pos.get(String(getId(n.id)));
          if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
            n.x = p.x;
            n.y = p.y;
          }
        });
      }

      function refreshPatternDiscoveryOnly() {
        if (!currentData) return;

        // Important: Pattern Discovery must only update scores/styles. It must not
        // recompute the layout or jump back to the initial node coordinates. Some
        // browsers fire repeated input/change events when users double-click the
        // number-input arrows, so we snapshot and restore the current G6 positions.
        const pos = snapshotGraphNodePositions();
        applyPositionSnapshotToCurrentData(pos);
        if (currentCommId != null) rememberCurrentNodePositions(currentCommId);

        computePatternDiscoveryState(currentData);

        applyPositionSnapshotToCurrentData(pos);
        invalidateSprites();
        updateStyles();
      }

      function schedulePatternDiscoveryRefresh(delay = 90) {
        if (patternDiscoveryRefreshTimer) clearTimeout(patternDiscoveryRefreshTimer);
        patternDiscoveryRefreshTimer = setTimeout(() => {
          patternDiscoveryRefreshTimer = null;
          refreshPatternDiscoveryOnly();
        }, delay);
      }

      d3.select('#patternDiscoveryToggle').on('change', function () {
        usePatternDiscovery = this.checked;
        if (!usePatternDiscovery) {
          patternDiscoveryNodeIds = new Set();
          patternDiscoveryEdgeIds = new Set();
          d3.select('#patternDiscoveryStatus').text('');
        }
        refreshPatternDiscoveryOnly();
      });

      d3.select('#patternThresholdScale').on('change', function () {
        // Disabled in the UI; kept as a safety fallback. Pattern Discovery remains z-score only.
        d3.select('#patternThresholdScale').property('value', 'zscore');
        updatePatternThresholdRanges(currentData, false);
        schedulePatternDiscoveryRefresh(30);
      });
      const controlsEl = document.getElementById('controls');
      if (controlsEl && !controlsEl._patternDiscoveryEventGuardInstalled) {
        controlsEl._patternDiscoveryEventGuardInstalled = true;
        ['dblclick', 'pointerdown', 'mousedown', 'wheel'].forEach(evtName => {
          controlsEl.addEventListener(evtName, function (event) {
            if (event.target && event.target.closest && event.target.closest('#patternDiscoveryRow, #patternData1ThresholdRow, #patternData2ThresholdRow, #patternStageAwareRow, #patternStageFreeRow')) {
              event.stopPropagation();
            }
          }, true);
        });
      }

      // Extra guard: number-input spinner interactions can emit double-click/change
      // sequences. Keep Pattern Discovery controls isolated from graph behaviors.
      ['#patternDiscoveryRow', '#patternData1ThresholdRow', '#patternData2ThresholdRow', '#patternStageAwareRow', '#patternStageFreeRow'].forEach(rowSel => {
        const rowEl = document.querySelector(rowSel);
        if (!rowEl || rowEl._pdNoLayoutResetGuard) return;
        rowEl._pdNoLayoutResetGuard = true;
        ['click', 'dblclick', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'wheel'].forEach(evtName => {
          rowEl.addEventListener(evtName, function (event) {
            event.stopPropagation();
          }, true);
        });
      });


      [
        ['#patternExpHighThresholdSlider', '#patternExpHighThresholdValue'],
        ['#patternExpLowThresholdSlider', '#patternExpLowThresholdValue'],
        ['#patternMtyHighThresholdSlider', '#patternMtyHighThresholdValue'],
        ['#patternMtyLowThresholdSlider', '#patternMtyLowThresholdValue'],
        ['#patternFinalTrendSlider', '#patternFinalTrendValue'],
        ['#patternStageEvidenceSlider', '#patternStageEvidenceValue'],
        ['#patternGlobalRateSlider', '#patternGlobalRateValue'],
        ['#patternFreeEvidenceSlider', '#patternFreeEvidenceValue'],
      ].forEach(([slider, input]) => syncPatternPair(slider, input, schedulePatternDiscoveryRefresh));

      updateDisplayModeControls();

      d3.select('#omicsType').on('change', () => {
        const omicsType = d3.select('#omicsType').property('value');
        const metric = omicsMetric[omicsType] || 'raw';
        d3.select('#dataType').property('value', metric);
        if (currentData) {
          updateValueRangeInputs(currentData.nodes);
          invalidateSprites();
          updateStyles();
        }
      });

      d3.select('#dataType').on('change', () => {
        const omicsType = d3.select('#omicsType').property('value');
        const metric = d3.select('#dataType').property('value');
        omicsMetric[omicsType] = metric;
        if (currentData) {
          updateValueRangeInputs(currentData.nodes);
          invalidateSprites();
          updateStyles();
        }
      });

      d3.select('#edgeMetric').on('change', async () => {
        if (!currentData) return;
        // Keep edgeFilterApplied as-is so the existing filter state continues
        // after changing edge metric / then changing degree range.
        setEdgeRangeInputs(currentData.edges);
        await refreshGraphData({ fit: false });
      });

      d3.select('#edgeFilterBtn').on('click', async () => {
        if (!currentData) return;
        edgeFilterApplied = true;
        await refreshGraphData({ fit: false });
      });

      d3.select('#filterBtn').on('click', () => {
        invalidateSprites();
        updateStyles();
      });

      d3.select('#useInteract').on('change', function () {
        useInteractMode = this.checked;
        updateStyles();
      });

      document.getElementById('fitBtn').onclick = () => {
        if (graph) graph.fitView({ when: 'always', direction: 'both', padding: 8 });
      };
      document.getElementById('savePNGBtn').onclick = () => savePNG();
      document.getElementById('saveSVGBtn').onclick = () => saveSVG();
      document.getElementById('saveJSONBtn').onclick = () => saveJSON();
      const downloadSnapshotBtn = document.getElementById('downloadSnapshotBtn');
      if (downloadSnapshotBtn) downloadSnapshotBtn.onclick = () => downloadSnapshotZip();

      document.getElementById('geneSearchBtn').onclick = focusGeneFromSearch;
      document.getElementById('geneClearBtn').onclick = clearGeneSearch;
      document.getElementById('geneSearchInput').addEventListener('keydown', event => {
        if (event.key === 'Enter') focusGeneFromSearch();
        if (event.key === 'Escape') clearGeneSearch();
      });
      document.getElementById('zoomIn').onclick = () => graph && graph.zoomBy(1.2);
      document.getElementById('zoomOut').onclick = () => graph && graph.zoomBy(1 / 1.2);

      await renderCommunity({ recomputeLayout: true, fit: true, resetFocus: true, resetEdgeRange: true });

      if (sid) {
        fetch('/cmt_figures/track/viewer_proxy.php?sid=' + encodeURIComponent(sid) + '&page=directed').catch(() => {});
      }
    } catch (err) {
      console.error('Viewer initialization failed:', err);
      const container = document.getElementById('networkViz');
      if (container) {
        container.innerHTML = `<div style="padding:24px;color:#b00020;font-family:sans-serif;">Viewer initialization failed: ${String(err.message || err)}</div>`;
      }
    }
  }

  init();
})();
</script>
</body>
</html>
