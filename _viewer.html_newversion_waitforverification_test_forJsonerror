  async function downloadSnapshotZip() {
    try {
      const state = collectSnapshotState();
      const communities = Array.isArray(window.allCommunities) ? window.allCommunities : [];
      if (!communities.length) throw new Error('No loaded community data to save.');

      const sid = state.ui?.sid || getSessionId() || 'nosid';
      const comm = state.viewer?.currentCommunity || 'community';
      const stamp = new Date().toISOString().replace(/[:.]/g, '-');
      const filename = `ringnet_snapshot_${sid}_${comm}_${stamp}.zip`;

      if (typeof JSZip === 'undefined') {
        // Fallback: if JSZip CDN is unavailable, still save a JSON snapshot.
        const fallback = {
          schema: 'ringnet.viewer.snapshot.bundle.v1',
          snapshot_state: state,
          community_map_top100: communities,
        };
        downloadBlob(
          new Blob([JSON.stringify(fallback, null, 2)], { type: 'application/json;charset=utf-8' }),
          filename.replace(/\.zip$/i, '.json')
        );
        return;
      }

      const zip = new JSZip();
      zip.file('community_map_top100.json', JSON.stringify(communities));
      zip.file('snapshot_state.json', JSON.stringify(state, null, 2));
      zip.file('README.txt', [
        'RingNet viewer snapshot',
        '',
        'community_map_top100.json: full graph/community data used by the viewer.',
        'snapshot_state.json: UI state, colors, active modes, selected samples, searched node, pattern state, and node positions.',
        '',
        'Upload this ZIP through the RingNet snapshot/JSON upload panel to reopen the same saved view.'
      ].join('\n'));

      const blob = await zip.generateAsync({
        type: 'blob',
        compression: 'DEFLATE',
        compressionOptions: { level: 6 },
      });
      downloadBlob(blob, filename);
    } catch (err) {
      console.error('Download snapshot failed:', err);
      alert('Download snapshot failed: ' + String(err.message || err));
    }
  }

