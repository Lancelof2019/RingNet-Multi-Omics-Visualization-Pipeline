          <input type="range" id="patternGlobalRateSlider" min="0" max="1" step="0.01" value="0.00" style="width:130px;">
          <input type="number" id="patternGlobalRateValue" value="0.00" min="0" max="1" step="0.01" style="width:70px;">
          <span id="patternGlobalRateRange" class="hint" style="margin-left:2px;"></span>
