  // ---------------------------------------------------------------------------
  // JSON omics diagnostics for debugging Raw / Min-Max / Z-score field mapping.
  // Open DevTools Console and run:
  //   debugOmicsRanges()
  //   debugOmicsRanges(currentData)
  //   debugOmicsRanges(window.allCommunities)
  // This prints the actual ranges read from JSON:
  //   Raw    -> *_vals
  //   Norm   -> *_norm
  //   Zscore -> *_z
  // ---------------------------------------------------------------------------
  function flattenNumericValuesFromNodes(nodes, key) {
    const values = [];
    (nodes || []).forEach(node => {
      const arr = Array.isArray(node?.[key]) ? node[key] : [];
      arr.forEach(v => {
        const n = toNum(v);
        if (Number.isFinite(n)) values.push(n);
      });
    });
    return values;
  }

  function summarizeNumericArray(values) {
    const arr = (values || []).map(toNum).filter(Number.isFinite).sort(d3.ascending);
    if (!arr.length) {
      return {
        n: 0,
        min: null,
        q05: null,
        q25: null,
        median: null,
        mean: null,
        q75: null,
        q95: null,
        max: null,
        negative_count: 0,
        zero_count: 0,
        positive_count: 0,
      };
    }

    const fmt = v => Number.isFinite(v) ? +Number(v).toFixed(6) : null;
    return {
      n: arr.length,
      min: fmt(arr[0]),
      q05: fmt(d3.quantileSorted(arr, 0.05)),
      q25: fmt(d3.quantileSorted(arr, 0.25)),
      median: fmt(d3.quantileSorted(arr, 0.50)),
      mean: fmt(d3.mean(arr)),
      q75: fmt(d3.quantileSorted(arr, 0.75)),
      q95: fmt(d3.quantileSorted(arr, 0.95)),
      max: fmt(arr[arr.length - 1]),
      negative_count: arr.filter(v => v < 0).length,
      zero_count: arr.filter(v => v === 0).length,
      positive_count: arr.filter(v => v > 0).length,
    };
  }

  function getDiagnosticDataArray(input = null) {
    const obj = input || currentData || window.allCommunities;
    if (!obj) return [];
    if (Array.isArray(obj)) return obj;
    if (Array.isArray(obj.nodes)) return [obj];
    if (typeof obj === 'object') return Object.values(obj).filter(d => d && Array.isArray(d.nodes));
    return [];
  }

  function debugOmicsRanges(input = null, options = {}) {
    const dataArr = getDiagnosticDataArray(input);
    const fields = [
      ['raw', 'vals'],
      ['minmax', 'norm'],
      ['zscore', 'z'],
    ];
    const omicsTypes = ['exp', 'mty', 'cnv', 'snv'];
    const rows = [];

    dataArr.forEach((commData, commIndex) => {
      const comm = commData?.comm ?? commIndex;
      omicsTypes.forEach(type => {
        fields.forEach(([mode, suffix]) => {
          const key = `${type}_${suffix}`;
          const values = flattenNumericValuesFromNodes(commData?.nodes || [], key);
          const s = summarizeNumericArray(values);
          rows.push({
            comm,
            omics: type,
            mode,
            json_key: key,
            ...s,
          });
        });
      });
    });

    console.groupCollapsed('[Omics JSON diagnostics] actual ranges from JSON fields');
    console.table(rows);

    const suspicious = rows.filter(r =>
      r.mode === 'raw' &&
      r.n > 0 &&
      (r.omics === 'exp' || r.omics === 'mty') &&
      Number.isFinite(r.min) && Number.isFinite(r.max) &&
      r.min >= -1.000001 && r.max <= 1.000001 && r.negative_count > 0
    );

    if (suspicious.length) {
      console.warn(
        '[Omics JSON diagnostics] Raw exp/mty fields contain negative values and are within [-1, 1]. ' +
        'This means the currently loaded JSON *_vals are already normalized-like values, or the JSON was generated from normalized input CSVs. ' +
        'The front-end Raw mode only reads *_vals; it does not convert raw to [-1, 1].',
        suspicious
      );
    }

    const currentModeRows = omicsTypes.map(type => {
      const metric = omicsMetric[type] || 'raw';
      const key = metricKey(type);
      const values = flattenNumericValuesFromNodes((currentData?.nodes || []), key);
      const s = summarizeNumericArray(values);
      return {
        omics: type,
        selected_metric: metric,
        selected_json_key: key,
        min: s.min,
        max: s.max,
        n: s.n,
        negative_count: s.negative_count,
        zero_count: s.zero_count,
        positive_count: s.positive_count,
      };
    });
    console.table(currentModeRows);

    if (options.sampleNode !== false && currentData?.nodes?.length) {
      const firstNode = currentData.nodes[0];
      const preview = {};
      omicsTypes.forEach(type => {
        ['vals', 'norm', 'z'].forEach(suffix => {
          const key = `${type}_${suffix}`;
          preview[key] = Array.isArray(firstNode?.[key]) ? firstNode[key].slice(0, 8) : null;
        });
      });
      console.log('[Omics JSON diagnostics] first node preview:', {
        node_id: firstNode.id,
        gene: firstNode.gene,
        preview,
      });
    }

    console.groupEnd();
    return rows;
  }

  window.debugOmicsRanges = debugOmicsRanges;

