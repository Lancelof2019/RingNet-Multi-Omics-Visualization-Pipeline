  </div>

  <div id="zoomControls">
    <button id="zoomIn">➕</button>
    <button id="zoomOut">➖</button>
  </div>

  <div id="networkContainer">
    <div id="networkViz"><svg id="selfLoopOverlay"></svg></div>
  </div>

<script>
(function () {
  const { Graph } = G6;

  let graph = null;
  let currentData = null;
  let overlayLoopCache = [];
  let overlayRenderRAF = null;
  let currentCommId = null;
  let currentLayoutMode = 'loose-balanced';
  let colorConfig = {};
  let useInteractMode = false;
  let showEdgeLabels = true;

  // Edge color picker override state:
  // false = initial display may use single-cell edge type / edge name colors.
  // true  = once user changes Edge Negative / Zero / Positive, those pickers control edge colors.
  let edgePickerTouched = false;

  // Optional preset palette. null keeps the original colors already defined in the HTML.
  let activeColorPalette = null;

  // The palette specification uses 8-digit #RRGGBBAA values.
  // Native <input type="color"> controls accept #RRGGBB only, so the final alpha
  // channel is stored in the preset definition and the RGB part is shown in the picker.
  // All preset colors below use FF (fully opaque), therefore no visual information is lost.
  const COLOR_PALETTES = {
    // The New England Journal of Medicine
    1: {
      exp:  { neg: '#0072B5FF', zero: '#FFFFFFFF', pos: '#BC3C29FF' },
      mty:  { neg: '#20854EFF', zero: '#FFFFFFFF', pos: '#E18727FF' },
      cnv:  { neg: '#FFDC91FF', zero: '#FFFFFFFF', pos: '#7876B1FF' },
      snv:  { neg: '#FFFFFFFF', zero: '#FFFFFFFF', pos: '#6F99ADFF' },
      edge: { neg: '#7FBC41FF', zero: '#F7F7F7FF', pos: '#DE77AEFF' },
    },
    // Nature Cancer
    2: {
      exp:  { neg: '#4DBBD5FF', zero: '#FFFFFFFF', pos: '#E64B35FF' },
      mty:  { neg: '#00A087FF', zero: '#FFFFFFFF', pos: '#7E6148FF' },
      cnv:  { neg: '#F39B7FFF', zero: '#FFFFFFFF', pos: '#8491B4FF' },
      snv:  { neg: '#FFFFFFFF', zero: '#FFFFFFFF', pos: '#1A1A1AFF' },
      edge: { neg: '#D6604DFF', zero: '#F7F7F7FF', pos: '#878787FF' },
    },
    // Lancet
    3: {
      exp:  { neg: '#00468BFF', zero: '#FFFFFFFF', pos: '#ED0000FF' },
      mty:  { neg: '#42B540FF', zero: '#FFFFFFFF', pos: '#FDAF91FF' },
      cnv:  { neg: '#0099B4FF', zero: '#FFFFFFFF', pos: '#925E9FFF' },
      snv:  { neg: '#FFFFFFFF', zero: '#FFFFFFFF', pos: '#1B1919FF' },
      edge: { neg: '#42B540FF', zero: '#F7F7F7FF', pos: '#AD002AFF' },
    },
    // Science
    4: {
      exp:  { neg: '#3B4992FF', zero: '#FFFFFFFF', pos: '#EE0000FF' },
      mty:  { neg: '#008B45FF', zero: '#FFFFFFFF', pos: '#A20056FF' },
      cnv:  { neg: '#B35806FF', zero: '#FFFFFFFF', pos: '#631879FF' },
      snv:  { neg: '#FFFFFFFF', zero: '#FFFFFFFF', pos: '#1B1919FF' },
      edge: { neg: '#008280FF', zero: '#F7F7F7FF', pos: '#BB0021FF' },
    },
  };

  function color8ToColorInput(value) {
    const s = String(value || '').trim();
    if (/^#[0-9a-fA-F]{8}$/.test(s)) return s.slice(0, 7);
    if (/^#[0-9a-fA-F]{6}$/.test(s)) return s;
    return '#000000';
  }

  function syncPaletteCheckboxes() {
    d3.select('#paletteOneToggle').property('checked', activeColorPalette === 1);
    d3.select('#paletteTwoToggle').property('checked', activeColorPalette === 2);
    d3.select('#paletteThreeToggle').property('checked', activeColorPalette === 3);
    d3.select('#paletteFourToggle').property('checked', activeColorPalette === 4);
  }

  function applyColorPalette(paletteId, { refresh = true } = {}) {
    const palette = COLOR_PALETTES[paletteId];
    if (!palette) return;

    activeColorPalette = Number(paletteId);
    ['exp', 'mty', 'cnv', 'snv'].forEach(type => {
      d3.select(`#${type}Neg`).property('value', color8ToColorInput(palette[type].neg));
      d3.select(`#${type}Zero`).property('value', color8ToColorInput(palette[type].zero));
      d3.select(`#${type}Pos`).property('value', color8ToColorInput(palette[type].pos));
    });
    d3.select('#edgeNeg').property('value', color8ToColorInput(palette.edge.neg));
    d3.select('#edgeZero').property('value', color8ToColorInput(palette.edge.zero));
    d3.select('#edgePos').property('value', color8ToColorInput(palette.edge.pos));

    // Preset edge colors should immediately control edge rendering.
    edgePickerTouched = true;
    syncPaletteCheckboxes();

    if (refresh) {
      getColorScales();
      invalidateSprites();
      updateStyles();
    }
  }

  function clearPaletteSelection() {
    activeColorPalette = null;
    syncPaletteCheckboxes();
  }

  let focusedNodeId = null;
  let neighborMap = new Map();
  let spriteDirty = true;

  let useDifferenceDisplay = false;
  let useSimilarityDisplay = false;
  let usePatternDiscovery = false;
  let globalDifferenceDisplayIndices = null;
  let globalSimilarityDisplayIndices = null;
  let autoNodeFilterInfo = [];

  // Pattern Discovery highlight state.
  // This mode does not remove nodes or edges. It only highlights the discovered
  // anti-pattern subgraph and dims unrelated nodes/edges until the checkbox is unchecked.
  let patternDiscoveryNodeIds = new Set();
  let patternDiscoveryEdgeIds = new Set();
  let patternDiscoveryInfo = {
    mode: 'unknown',
    matchedNodes: 0,
    matchedEdges: 0,
    totalNodes: 0,
    totalEdges: 0,
  };

  // Pattern Discovery performance controls.
  // Full per-node console tables are expensive for large graphs, so they are disabled by default.
  // In DevTools, run: window.PATTERN_DISCOVERY_DEBUG = true; then change a Pattern Discovery slider
  // to print the full kept/discarded node tables.
